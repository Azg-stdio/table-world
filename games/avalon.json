  "game": {
    "id": "avalon",
    "name": "Avalon",
    "description": "Hidden loyalties: good completes three quests, evil fails three or finds Merlin at the end. A leader picks each quest's team, everyone votes on it, and the team succeeds or fails it in secret.",
    "language": "en",
    "minPlayers": 5,
    "maxPlayers": 10
  },
  "variables": {
    "quest": 1,
    "size": 2,
    "needFails": 1,
    "team": [],
    "successes": 0,
    "fails": 0,
    "rejections": 0
  },
  "turn": {
    "startingPlayer": "random",
    "phases": [
      "propose",
      "team_vote",
      "quest",
      "assassinate"
    ]
  },
  "phases": [
    {
      "id": "propose",
      "name": "Pick the team",
      "actions": [
        "pick",
        "unpick",
        "propose"
      ],
      "onEnter": [
        {
          "lua": {
            "call": "setQuest"
          }
        },
        {
          "setVariable": {
            "name": "team",
            "value": []
          }
        },
        {
          "message": {
            "text": "@leads"
          }
        }
      ]
    },
    {
      "id": "team_vote",
      "name": "Vote on the team",
      "actions": [
        "team_vote"
      ]
    },
    {
      "id": "quest",
      "name": "Quest",
      "actions": [
        "quest"
      ]
    },
    {
      "id": "assassinate",
      "name": "The Assassin strikes",
      "actions": [
        "assassinate"
      ]
    }
  ],
  "actions": [
    {
      "id": "pick",
      "name": "Pick",
      "params": [
        {
          "name": "member",
          "type": "seat"
        }
      ],
      "preconditions": [
        {
          "not": {
            "inList": {
              "list": "$var.team",
              "value": "$param.member"
            }
          }
        },
        {
          "compare": {
            "left": "$var.team.count",
            "op": "<",
            "right": "$var.size"
          }
        }
      ],
      "effects": [
        {
          "setVariable": {
            "name": "team",
            "add": "$param.member"
          }
        },
        {
          "message": {
            "text": "@picks"
          }
        }
      ]
    },
    {
      "id": "unpick",
      "name": "Take off the team",
      "params": [
        {
          "name": "member",
          "type": "seat"
        }
      ],
      "preconditions": [
        {
          "inList": {
            "list": "$var.team",
            "value": "$param.member"
          }
        }
      ],
      "effects": [
        {
          "setVariable": {
            "name": "team",
            "remove": "$param.member"
          }
        },
        {
          "message": {
            "text": "@unpicks"
          }
        }
      ]
    },
    {
      "id": "propose",
      "name": "Propose this team",
      "preconditions": [
        {
          "compare": {
            "left": "$var.team.count",
            "op": "==",
            "right": "$var.size"
          }
        }
      ],
      "effects": [
        {
          "message": {
            "text": "@proposes"
          }
        },
        {
          "endPhase": {}
        }
      ]
    },
    {
      "id": "team_vote",
      "name": "Team vote",
      "actor": "any",
      "vote": {
        "options": [
          "approve",
          "reject"
        ],
        "labels": {
          "approve": "Approve",
          "reject": "Reject"
        },
        "decide": "majority",
        "otherwise": "reject",
        "onResult": [
          {
            "if": {
              "condition": {
                "compare": {
                  "left": "$vote.result",
                  "op": "==",
                  "right": "approve"
                }
              },
              "then": [
                {
                  "setVariable": {
                    "name": "rejections",
                    "value": 0
                  }
                },
                {
                  "gotoPhase": {
                    "phase": "quest"
                  }
                }
              ],
              "else": [
                {
                  "setVariable": {
                    "name": "rejections",
                    "delta": 1.0
                  }
                },
                {
                  "if": {
                    "condition": {
                      "compare": {
                        "left": "$var.rejections",
                        "op": ">=",
                        "right": 5
                      }
                    },
                    "then": [
                      {
                        "message": {
                          "text": "@fiveRejected"
                        }
                      },
                      {
                        "forEach": {
                          "players": true,
                          "do": [
                            {
                              "revealRole": {
                                "seat": "$it"
                              }
                            }
                          ]
                        }
                      },
                      {
                        "win": {
                          "player": "",
                          "team": "evil"
                        }
                      }
                    ],
                    "else": [
                      {
                        "endTurn": {}
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "id": "quest",
      "name": "Quest",
      "actor": "any",
      "preconditions": [
        {
          "or": [
            {
              "compare": {
                "left": "$actor.team",
                "op": "==",
                "right": "evil"
              }
            },
            {
              "compare": {
                "left": "$param.choice",
                "op": "==",
                "right": "success"
              }
            }
          ]
        }
      ],
      "vote": {
        "options": [
          "success",
          "fail"
        ],
        "labels": {
          "success": "Success",
          "fail": "Fail"
        },
        "who": "$var.team",
        "reveal": "count",
        "decide": "none",
        "onResult": [
          {
            "if": {
              "condition": {
                "compare": {
                  "left": "$vote.fail",
                  "op": ">=",
                  "right": "$var.needFails"
                }
              },
              "then": [
                {
                  "setVariable": {
                    "name": "fails",
                    "delta": 1.0
                  }
                },
                {
                  "message": {
                    "text": "@questFails"
                  }
                }
              ],
              "else": [
                {
                  "setVariable": {
                    "name": "successes",
                    "delta": 1.0
                  }
                },
                {
                  "message": {
                    "text": "@questSucceeds"
                  }
                }
              ]
            }
          },
          {
            "if": {
              "condition": {
                "compare": {
                  "left": "$var.fails",
                  "op": ">=",
                  "right": 3
                }
              },
              "then": [
                {
                  "message": {
                    "text": "@threeFailed"
                  }
                },
                {
                  "forEach": {
                    "players": true,
                    "do": [
                      {
                        "revealRole": {
                          "seat": "$it"
                        }
                      }
                    ]
                  }
                },
                {
                  "win": {
                    "player": "",
                    "team": "evil"
                  }
                }
              ],
              "else": [
                {
                  "if": {
                    "condition": {
                      "compare": {
                        "left": "$var.successes",
                        "op": ">=",
                        "right": 3
                      }
                    },
                    "then": [
                      {
                        "message": {
                          "text": "@threeSucceeded"
                        }
                      },
                      {
                        "gotoPhase": {
                          "phase": "assassinate"
                        }
                      }
                    ],
                    "else": [
                      {
                        "setVariable": {
                          "name": "quest",
                          "delta": 1.0
                        }
                      },
                      {
                        "endTurn": {}
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "id": "assassinate",
      "name": "Name Merlin",
      "actor": "any",
      "params": [
        {
          "name": "target",
          "type": "seat"
        }
      ],
      "preconditions": [
        {
          "compare": {
            "left": "$actor.role",
            "op": "==",
            "right": "assassin"
          }
        },
        {
          "not": {
            "compare": {
              "left": "$param.target",
              "op": "==",
              "right": "$actor.id"
            }
          }
        }
      ],
      "effects": [
        {
          "revealRole": {
            "seat": "$param.target"
          }
        },
        {
          "if": {
            "condition": {
              "compare": {
                "left": "$param.target.role",
                "op": "==",
                "right": "merlin"
              }
            },
            "then": [
              {
                "message": {
                  "text": "@wasMerlin"
                }
              },
              {
                "forEach": {
                  "players": true,
                  "do": [
                    {
                      "revealRole": {
                        "seat": "$it"
                      }
                    }
                  ]
                }
              },
              {
                "win": {
                  "player": "",
                  "team": "evil"
                }
              }
            ],
            "else": [
              {
                "message": {
                  "text": "@wasNotMerlin"
                }
              },
              {
                "forEach": {
                  "players": true,
                  "do": [
                    {
                      "revealRole": {
                        "seat": "$it"
                      }
                    }
                  ]
                }
              },
              {
                "win": {
                  "player": "",
                  "team": "good"
                }
              }
            ]
          }
        }
      ]
    }
  ],
  "ui": {
    "panels": [
      {
        "id": "quests",
        "title": "Avalon",
        "anchor": "right",
        "elements": [
          {
            "text": "Quest {$var.quest} of 5: a team of {$var.size}"
          },
          {
            "text": "Fails that sink it: {$var.needFails}"
          },
          {
            "text": "Succeeded {$var.successes} · Failed {$var.fails}"
          },
          {
            "text": "Rejected teams: {$var.rejections} of 5"
          },
          {
            "text": "Leader: {$current.name}"
          },
          {
            "text": "Team: {$var.team}"
          }
        ]
      }
    ]
  },
  "scripts": {
    "global": "\nSIZES = { [5] = {2, 3, 2, 3, 3}, [6] = {2, 3, 4, 3, 4}, [7] = {2, 3, 3, 4, 4},\n          [8] = {3, 4, 4, 5, 5}, [9] = {3, 4, 4, 5, 5}, [10] = {3, 4, 4, 5, 5} }\n\n-- The team size and the fails it takes for the quest about to be played.\nfunction setQuest(ctx)\n  local players = #Game.getSeats()\n  local quest = Game.getVariable(\"quest\")\n  Game.setVariable(\"size\", SIZES[players][quest])\n  if quest == 4 and players >= 7 then Game.setVariable(\"needFails\", 2) else Game.setVariable(\"needFails\", 1) end\nend\n"
  },
  "roles": {
    "teams": [
      {
        "id": "good",
        "name": "Loyal servants of Arthur"
      },
      {
        "id": "evil",
        "name": "Minions of Mordred"
      }
    ],
    "list": [
      {
        "id": "merlin",
        "name": "Merlin",
        "team": "good",
        "description": "Knows the evil players, except Mordred. Must stay hidden from the Assassin."
      },
      {
        "id": "percival",
        "name": "Percival",
        "team": "good",
        "optional": true,
        "description": "Sees Merlin and Morgana, not which is which."
      },
      {
        "id": "servant",
