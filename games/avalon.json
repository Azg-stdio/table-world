      },
      {
        "id": "assassin",
        "name": "Assassin",
        "team": "evil",
        "description": "Names one good player at the end: Merlin means evil wins."
      },
      {
        "id": "morgana",
        "name": "Morgana",
        "team": "evil",
        "optional": true,
        "description": "Appears as Merlin to Percival."
      },
      {
        "id": "mordred",
        "name": "Mordred",
        "team": "evil",
        "optional": true,
        "description": "Hidden from Merlin."
      },
      {
        "id": "oberon",
        "name": "Oberon",
        "team": "evil",
        "optional": true,
        "description": "Unknown to the other minions, and knows none of them."
      },
      {
        "id": "minion",
        "name": "Minion of Mordred",
        "team": "evil",
        "count": "fill"
      }
    ],
    "byPlayers": {
      "5": {
        "good": 3,
