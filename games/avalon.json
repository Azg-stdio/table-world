            "inList": {
              "list": "$var.team",
              "value": "$param.member"
            }
          }
        },
        {
          "compare": {
            "left": "$var.team.count",
            "op": "<",
            "right": "$var.size"
          }
        }
      ],
      "effects": [
        {
          "setVariable": {
            "name": "team",
            "add": "$param.member"
          }
        },
        {
          "lua": {
            "call": "shieldsToTeam"
          }
        },
        {
          "message": {
            "text": "@picks"
          }
        }
      ]
    },
    {
      "id": "unpick",
      "name": "Take off the team",
      "params": [
        {
          "name": "member",
          "type": "seat"
        }
      ],
      "preconditions": [
        {
          "inList": {
            "list": "$var.team",
            "value": "$param.member"
          }
        }
      ],
      "effects": [
        {
          "setVariable": {
            "name": "team",
            "remove": "$param.member"
          }
        },
        {
          "lua": {
            "call": "shieldsToTeam"
          }
        },
        {
          "message": {
            "text": "@unpicks"
          }
        }
      ]
    },
    {
      "id": "propose",
      "name": "Propose this team",
      "preconditions": [
        {
          "compare": {
            "left": "$var.team.count",
            "op": "==",
            "right": "$var.size"
          }
        }
      ],
      "effects": [
        {
          "message": {
            "text": "@proposes"
          }
        },
        {
          "endPhase": {}
        }
      ]
    },
    {
      "id": "team_vote",
      "name": "Team vote",
      "actor": "any",
      "vote": {
        "options": [
          "approve",
          "reject"
        ],
        "labels": {
          "approve": "Approve",
          "reject": "Reject"
        },
        "decide": "majority",
        "otherwise": "reject",
        "onResult": [
          {
            "if": {
              "condition": {
                "compare": {
                  "left": "$vote.result",
                  "op": "==",
                  "right": "approve"
                }
              },
              "then": [
                {
                  "setVariable": {
                    "name": "rejections",
                    "value": 0
                  }
                },
                {
                  "lua": {
                    "call": "rejectTrack"
                  }
                },
                {
                  "gotoPhase": {
                    "phase": "quest"
                  }
                }
              ],
              "else": [
                {
                  "setVariable": {
                    "name": "rejections",
                    "delta": 1.0
                  }
                },
                {
                  "lua": {
                    "call": "rejectTrack"
                  }
                },
                {
                  "if": {
                    "condition": {
                      "compare": {
                        "left": "$var.rejections",
                        "op": ">=",
                        "right": 5
                      }
                    },
                    "then": [
                      {
                        "message": {
                          "text": "@fiveRejected"
                        }
                      },
                      {
                        "forEach": {
                          "players": true,
                          "do": [
                            {
                              "revealRole": {
                                "seat": "$it"
                              }
                            }
                          ]
                        }
                      },
                      {
                        "win": {
                          "player": "",
                          "team": "evil"
                        }
                      }
                    ],
                    "else": [
                      {
                        "endTurn": {}
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "id": "quest",
      "name": "Quest",
      "actor": "any",
      "preconditions": [
        {
          "or": [
            {
              "compare": {
                "left": "$actor.team",
                "op": "==",
                "right": "evil"
              }
            },
            {
              "compare": {
                "left": "$param.choice",
                "op": "==",
                "right": "success"
              }
            }
          ]
        }
      ],
      "vote": {
        "options": [
          "success",
          "fail"
        ],
        "labels": {
          "success": "Success",
          "fail": "Fail"
        },
        "who": "$var.team",
        "reveal": "count",
        "decide": "none",
        "onResult": [
          {
            "if": {
              "condition": {
                "compare": {
                  "left": "$vote.fail",
                  "op": ">=",
                  "right": "$var.needFails"
                }
              },
              "then": [
                {
                  "setVariable": {
                    "name": "fails",
                    "delta": 1.0
                  }
                },
                {
                  "lua": {
                    "call": "markQuest",
                    "args": {
                      "result": "fail"
                    }
                  }
                },
                {
                  "message": {
                    "text": "@questFails"
                  }
                }
              ],
              "else": [
                {
                  "setVariable": {
                    "name": "successes",
                    "delta": 1.0
                  }
                },
                {
                  "lua": {
                    "call": "markQuest",
                    "args": {
                      "result": "success"
                    }
                  }
                },
                {
                  "message": {
                    "text": "@questSucceeds"
                  }
                }
              ]
            }
          },
          {
            "if": {
              "condition": {
                "compare": {
                  "left": "$var.fails",
                  "op": ">=",
                  "right": 3
                }
              },
              "then": [
                {
                  "message": {
                    "text": "@threeFailed"
                  }
                },
                {
                  "forEach": {
                    "players": true,
                    "do": [
                      {
                        "revealRole": {
                          "seat": "$it"
                        }
                      }
                    ]
                  }
                },
                {
                  "win": {
                    "player": "",
                    "team": "evil"
                  }
                }
              ],
              "else": [
                {
                  "if": {
                    "condition": {
                      "compare": {
                        "left": "$var.successes",
                        "op": ">=",
                        "right": 3
                      }
                    },
                    "then": [
                      {
                        "message": {
                          "text": "@threeSucceeded"
                        }
                      },
                      {
                        "gotoPhase": {
                          "phase": "assassinate"
                        }
                      }
                    ],
                    "else": [
                      {
                        "setVariable": {
                          "name": "quest",
                          "delta": 1.0
                        }
                      },
                      {
                        "endTurn": {}
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "id": "assassinate",
      "name": "Name Merlin",
      "actor": "any",
      "params": [
        {
          "name": "target",
          "type": "seat"
        }
      ],
      "preconditions": [
        {
          "compare": {
            "left": "$actor.role",
            "op": "==",
            "right": "assassin"
          }
        },
        {
          "not": {
            "compare": {
              "left": "$param.target",
              "op": "==",
              "right": "$actor.id"
            }
          }
        }
      ],
      "effects": [
        {
          "revealRole": {
            "seat": "$param.target"
          }
        },
        {
          "if": {
            "condition": {
              "compare": {
                "left": "$param.target.role",
                "op": "==",
                "right": "merlin"
              }
            },
            "then": [
              {
                "message": {
                  "text": "@wasMerlin"
                }
              },
              {
                "forEach": {
                  "players": true,
                  "do": [
                    {
                      "revealRole": {
                        "seat": "$it"
                      }
                    }
                  ]
                }
              },
              {
                "win": {
                  "player": "",
                  "team": "evil"
                }
              }
            ],
            "else": [
              {
                "message": {
                  "text": "@wasNotMerlin"
                }
              },
              {
                "forEach": {
                  "players": true,
                  "do": [
                    {
                      "revealRole": {
                        "seat": "$it"
                      }
                    }
                  ]
                }
              },
              {
                "win": {
                  "player": "",
                  "team": "good"
                }
              }
            ]
          }
        }
      ]
    }
  ],
  "ui": {
    "panels": [
      {
        "id": "quests",
        "title": "Avalon",
        "anchor": "right",
        "elements": [
          {
            "text": "Quest {$var.quest} of 5: a team of {$var.size}"
          },
          {
            "text": "Fails that sink it: {$var.needFails}"
          },
          {
            "text": "Succeeded {$var.successes} · Failed {$var.fails}"
          },
          {
            "text": "Rejected teams: {$var.rejections} of 5"
          },
          {
            "text": "Leader: {$current.name}"
          },
          {
            "text": "Team: {$var.team}"
          }
        ]
      }
    ]
  },
  "scripts": {
    "global": "\nSIZES = { [5] = {2, 3, 2, 3, 3}, [6] = {2, 3, 4, 3, 4}, [7] = {2, 3, 3, 4, 4},\n          [8] = {3, 4, 4, 5, 5}, [9] = {3, 4, 4, 5, 5}, [10] = {3, 4, 4, 5, 5} }\n\n-- The team size and the fails it takes for the quest about to be played.\nfunction setQuest(ctx)\n  local players = #Game.getSeats()\n  local quest = Game.getVariable(\"quest\")\n  Game.setVariable(\"size\", SIZES[players][quest])\n  if quest == 4 and players >= 7 then Game.setVariable(\"needFails\", 2) else Game.setVariable(\"needFails\", 1) end\nend\n\n-- The pieces on the table follow the game: the crown before the leader, a shield before each member of the team,\n-- a blue or red checker on each quest card once played, the marker on the rejection track.\nSHIELDS = {\"shield\", \"shield_2\", \"shield_3\", \"shield_4\", \"shield_5\"}\nHOME = {}\n\nlocal function at(id)\n  local o = getObjectFromGUID(id)\n  return o and o.getPosition()\nend\n\nlocal function put(id, p)\n  local o = getObjectFromGUID(id)\n  if HOME[id] == nil and o then HOME[id] = o.getPosition() end\n  if o and p then o.setPositionSmooth({x = p.x, y = p.y + 1, z = p.z}) end\nend\n\n-- Before a seat, between its edge of the table and the middle (share of the way from the middle to its hand).\nlocal function before(seat, share)\n  local p = at(\"hand_\" .. seat:match(\"(%d+)$\"))\n  return {x = p.x * share, y = p.y, z = p.z * share}\nend\n\nfunction crownToLeader(ctx)\n  put(\"crown\", before(Game.getCurrentSeat(), 0.8))\nend\n\nfunction shieldsToTeam(ctx)\n  local team = Game.getVariable(\"team\") or {}\n  for i, id in ipairs(SHIELDS) do\n    put(id, nil)\n    if team[i] then put(id, before(team[i], 0.62)) else put(id, HOME[id]) end\n  end\nend\n\nfunction markQuest(ctx)\n  local quest = math.floor(Game.getVariable(\"quest\"))\n  if ctx.args.result == \"fail\" then\n    local n = math.floor(Game.getVariable(\"fails\"))\n    put(n == 1 and \"evil\" or (\"evil_\" .. n), at(\"quest_\" .. quest))\n  else\n    local n = math.floor(Game.getVariable(\"successes\"))\n    put(n == 1 and \"good\" or (\"good_\" .. n), at(\"quest_\" .. quest))\n  end\nend\n\nfunction rejectTrack(ctx)\n  local n = math.floor(Game.getVariable(\"rejections\"))\n  put(\"reject_marker\", nil)\n  if n == 0 then put(\"reject_marker\", HOME[\"reject_marker\"]) else put(\"reject_marker\", at(\"reject_\" .. n)) end\nend\n"
  },
