 "players": {
  "seats": [
   {
    "id": "seat_south",
    "color": "red"
   },
   {
    "id": "seat_north",
    "color": "blue"
   }
  ]
 },
 "turn": {
  "order": "clockwise",
  "startingPlayer": "first",
  "phases": [
   "battle",
   "resolve"
  ]
 },
 "phases": [
  {
   "id": "battle",
   "name": "Battle",
   "actions": [
    "play_top_card"
   ],
   "advanceWhen": {
    "allPlayersActed": true
   }
  },
  {
   "id": "resolve",
   "name": "Resolve",
   "advanceWhen": {
    "immediate": true
   },
   "onEnter": [
    {
     "if": {
      "condition": {
       "compare": {
        "left": "$seat.seat_south.battle.top.meta.rank",
        "op": ">",
        "right": "$seat.seat_north.battle.top.meta.rank"
       }
      },
      "then": [
       {
        "shuffle": {
         "object": "$seat.seat_south.battle"
        }
       },
       {
        "shuffle": {
         "object": "$seat.seat_north.battle"
        }
       },
       {
        "move": {
         "from": "$seat.seat_south.battle",
         "take": "all",
         "to": "$seat.seat_south.deck",
         "at": "bottom"
        }
       },
       {
        "move": {
         "from": "$seat.seat_north.battle",
         "take": "all",
         "to": "$seat.seat_south.deck",
         "at": "bottom"
        }
       },
       {
        "message": {
         "text": "seat_south wins the battle ({$seat.seat_south.deck.count} cards)"
        }
       }
      ],
      "else": [
       {
        "if": {
         "condition": {
          "compare": {
           "left": "$seat.seat_south.battle.top.meta.rank",
           "op": "<",
           "right": "$seat.seat_north.battle.top.meta.rank"
          }
         },
         "then": [
          {
           "shuffle": {
            "object": "$seat.seat_north.battle"
           }
          },
          {
           "shuffle": {
            "object": "$seat.seat_south.battle"
           }
          },
          {
           "move": {
            "from": "$seat.seat_north.battle",
            "take": "all",
            "to": "$seat.seat_north.deck",
            "at": "bottom"
           }
          },
          {
           "move": {
            "from": "$seat.seat_south.battle",
            "take": "all",
            "to": "$seat.seat_north.deck",
            "at": "bottom"
           }
          },
          {
           "message": {
            "text": "seat_north wins the battle ({$seat.seat_north.deck.count} cards)"
           }
          }
         ],
         "else": [
          {
           "message": {
            "text": "War!"
           }
          },
          {
           "forEach": {
            "players": true,
            "do": [
             {
              "if": {
               "condition": {
                "zoneCount": {
                 "zone": "$it.deck",
                 "op": "<",
                 "value": 2
                }
               },
               "then": [
                {
                 "message": {
                  "text": "{$it.id} cannot go to war"
                 }
                },
                {
                 "win": {
                  "player": "$other"
                 }
                }
               ],
               "else": [
                {
                 "move": {
                  "from": "$it.deck",
                  "to": "$it.battle",
                  "faceUp": false
                 }
                }
               ]
              }
             }
            ]
           }
          },
          {
           "gotoPhase": {
            "phase": "battle"
           }
          }
         ]
        }
       }
      ]
     }
    }
   ]
  }
 ],
 "actions": [
  {
   "id": "play_top_card",
   "name": "Play top card",
   "actor": "any",
   "limitPerPhase": 1,
   "preconditions": [
    {
     "zoneCount": {
      "zone": "$actor.deck",
      "op": ">",
      "value": 0
     }
    }
   ],
   "effects": [
    {
     "move": {
      "from": "$actor.deck",
      "to": "$actor.battle",
      "faceUp": true
     }
    }
   ]
  }
 ],
 "events": {
  "onGameStart": [
   {
    "shuffle": {
     "object": "deck_main"
    }
   },
   {
    "deal": {
     "from": "deck_main",
     "count": 26,
     "toTag": "deck",
     "faceDown": true
    }
   }
  ],
  "onTurnEnd": [
   {
    "setVariable": {
     "name": "battles",
     "delta": 1
    }
   }
  ]
 },
 "variables": {
  "battles": 0
 },
 "ui": {
  "panels": [
   {
    "id": "score",
    "title": "War",
    "anchor": "topRight",
    "elements": [
     {
      "type": "label",
      "text": "Battle {$var.battles}"
     },
     {
      "type": "counter",
      "text": "South's deck",
      "value": "$seat.seat_south.deck.count"
     },
     {
      "type": "counter",
      "text": "North's deck",
      "value": "$seat.seat_north.deck.count"
     },
     {
      "type": "button",
      "text": "South: play top card",
      "action": "play_top_card",
      "seat": "seat_south"
     },
     {
      "type": "button",
      "text": "North: play top card",
      "action": "play_top_card",
      "seat": "seat_north"
     }
    ]
   }
  ]
 },
 "winConditions": [
  {
   "when": {
    "and": [
     {
      "zoneCount": {
       "zone": "$player.deck",
       "op": "==",
       "value": 0
      }
     },
     {
      "zoneCount": {
       "zone": "$player.battle",
       "op": "==",
       "value": 0
      }
     }
    ]
   },
   "winner": "$other",
   "checkAfter": "turnEnd"
  },
  {
   "when": {
    "and": [
     {
      "variable": {
       "name": "battles",
       "op": ">=",
       "value": 500
      }
     },
     {
      "compare": {
       "left": "$player.deck.count",
       "op": ">",
       "right": "$other.deck.count"
      }
     }
    ]
   },
   "winner": "$player",
   "checkAfter": "turnEnd"
  }
 ]
}
