    "id": "seat_north",
    "color": "blue",
    "handZone": "hand_north"
   }
  ]
 },
 "turn": {
  "order": "clockwise",
  "startingPlayer": "first",
  "phases": [
   "play"
  ]
 },
 "phases": [
  {
   "id": "play",
   "name": "Play or draw",
   "actions": [
    "play_card",
    "draw_card"
   ],
   "advanceWhen": {
    "currentPlayerEnds": true
   }
  }
 ],
 "actions": [
  {
   "id": "play_card",
   "name": "Play a card",
   "actor": "current",
   "params": [
    {
     "name": "card",
     "type": "object",
     "filter": {
      "inZone": "$actor.hand",
      "type": "Card"
     }
    }
   ],
   "preconditions": [
    {
     "or": [
      {
       "compare": {
        "left": "$param.card.meta.suit",
        "op": "==",
        "right": "$obj.discard.top.meta.suit"
       }
      },
      {
       "compare": {
        "left": "$param.card.meta.rank",
        "op": "==",
        "right": "$obj.discard.top.meta.rank"
       }
      }
     ]
    }
   ],
   "effects": [
    {
     "move": {
      "object": "$param.card",
      "to": "discard"
     }
    },
    {
     "message": {
      "text": "{$actor.id} plays {$obj.discard.top.name}"
     }
    },
    {
     "endTurn": {}
    }
   ]
  },
  {
   "id": "draw_card",
   "name": "Draw a card",
   "actor": "current",
   "effects": [
    {
     "if": {
      "condition": {
       "zoneCount": {
        "zone": "draw",
        "op": "==",
        "value": 0
       }
      },
      "then": [
       {
        "move": {
         "from": "discard",
         "take": "allButTop",
         "to": "draw"
        }
       },
       {
        "shuffle": {
         "object": "draw"
        }
       }
      ]
     }
    },
    {
     "if": {
      "condition": {
       "zoneCount": {
        "zone": "draw",
        "op": ">",
        "value": 0
       }
      },
      "then": [
       {
        "move": {
         "from": "draw",
         "to": "$actor.hand",
         "faceUp": true
        }
       }
      ]
     }
    },
    {
     "endTurn": {}
    }
   ]
  }
 ],
 "events": {
  "onGameStart": [
   {
    "shuffle": {
     "object": "draw"
    }
   },
   {
    "deal": {
     "from": "draw",
     "count": 7,
     "toZone": "$it.hand"
    }
   },
   {
    "move": {
     "from": "draw",
     "to": "discard",
     "faceUp": true
    }
   }
  ]
 },
 "winConditions": [
  {
   "when": {
    "zoneCount": {
     "zone": "$player.hand",
     "op": "==",
     "value": 0
    }
   },
   "winner": "$player",
   "checkAfter": "anyCommand"
  }
 ]
}
