  "game": {
    "id": "wink-murder",
    "name": "Wink Murder",
    "description": "One of you is the Murderer and kills by winking. Watch the faces: catch the wink before everyone is gone. Look at someone and press K to wink.",
    "minPlayers": 5,
    "maxPlayers": 12
  },
  "turn": {
    "startingPlayer": "first",
    "phases": [
      "party"
    ]
  },
  "phases": [
    {
      "id": "party",
      "name": "The party",
      "actions": [
        "fall",
        "accuse"
      ]
    }
  ],
  "actions": [
    {
      "id": "fall",
      "name": "Fall",
      "actor": "any",
      "preconditions": [
        {
          "compare": {
            "left": "$actor.role.fate",
            "op": "==",
            "right": "winked"
          }
        }
      ],
      "effects": [
        {
          "message": {
            "text": "{$actor.name} falls to the floor."
          }
        },
        {
          "eliminate": {
            "seat": "$actor",
            "revealRole": true
          }
        }
      ]
    },
    {
      "id": "accuse",
      "name": "Accuse",
      "actor": "any",
      "params": [
        {
          "name": "suspect",
          "type": "seat"
        }
      ],
      "preconditions": [
        {
          "not": {
            "compare": {
              "left": "$param.suspect",
              "op": "==",
              "right": "$actor.id"
            }
          }
        },
        {
          "or": [
            {
              "compare": {
                "left": "$actor.role",
                "op": "==",
                "right": "detective"
              }
            },
            {
              "compare": {
                "left": "$alive.role.detective",
                "op": "==",
                "right": 0
              }
            }
          ]
        }
      ],
      "effects": [
        {
          "message": {
            "text": "{$actor.name} accuses {$param.suspect.name}!"
          }
        },
        {
          "if": {
            "condition": {
              "compare": {
                "left": "$param.suspect.role",
                "op": "==",
                "right": "murderer"
              }
            },
            "then": [
              {
                "revealRole": {
                  "seat": "$param.suspect"
                }
              },
              {
                "win": {
                  "player": "",
                  "team": "town"
                }
              }
            ],
            "else": [
              {
                "message": {
                  "text": "Wrong: {$param.suspect.name} is innocent."
                }
              },
              {
                "eliminate": {
                  "seat": "$actor",
                  "revealRole": true
                }
              }
            ]
          }
        }
      ]
    }
  ],
  "events": {
    "onGesture": [
      {
        "if": {
          "condition": {
            "and": [
              {
                "compare": {
                  "left": "$param.gesture",
                  "op": "==",
                  "right": "wink"
                }
              },
              {
                "compare": {
                  "left": "$actor.role",
                  "op": "==",
                  "right": "murderer"
                }
              },
              {
                "not": {
                  "compare": {
                    "left": "$param.target",
                    "op": "==",
                    "right": null
                  }
                }
              },
              {
                "not": {
                  "compare": {
                    "left": "$param.target.out",
                    "op": "==",
                    "right": true
                  }
                }
              }
            ]
          },
          "then": [
            {
              "setRole": {
                "seat": "$param.target",
                "role": "winked",
                "set": "fate"
              }
            },
            {
              "message": {
                "text": "You have been winked at. Count to five, then fall.",
                "to": "$param.target"
              }
            }
          ]
        }
      }
    ]
  },
  "winConditions": [
    {
      "team": "murderer",
      "when": {
        "compare": {
          "left": "$alive.count",
          "op": "<=",
          "right": 2
        }
      },
      "winner": "$player"
    }
  ],
  "roles": {
    "teams": [
      {
        "id": "town",
        "name": "The town"
      },
      {
        "id": "murderer",
        "name": "The Murderer"
      }
    ],
    "list": [
      {
        "id": "murderer",
        "name": "Murderer",
        "team": "murderer",
        "description": "Wink (K) at a player looking at you to kill them."
      },
      {
        "id": "detective",
        "name": "Detective",
        "team": "town",
        "optional": true,
        "description": "Accuse the Murderer; a wrong guess puts you out."
      },
      {
        "id": "guest",
        "name": "Guest",
        "team": "town",
        "count": "fill"
      },
      {
        "id": "alive",
        "name": "Alive",
        "team": "",
        "set": "fate",
        "count": "fill"
      },
      {
        "id": "winked",
        "name": "Winked at",
        "team": "",
        "set": "fate",
        "count": 0
      }
    ]
  }
}