  "game": {
    "id": "werewolf",
    "name": "Werewolf",
    "description": "A village hides werewolves. By night they kill in secret while the Seer and the Doctor work; by day everyone talks and votes to lynch a suspect. The village wins when no wolf is left, the wolves when they are as many as the villagers.",
    "minPlayers": 6,
    "maxPlayers": 12
  },
  "variables": {
    "night": 1,
    "victim": "",
    "saved": ""
  },
  "secretVariables": [
    "victim",
    "saved"
  ],
  "turn": {
    "startingPlayer": "first",
    "phases": [
      "wolves",
      "seer",
      "doctor",
      "dawn",
      "day"
    ]
  },
  "phases": [
    {
      "id": "wolves",
      "name": "Night: the werewolves",
      "actions": [
        "hunt"
      ],
      "onEnter": [
        {
          "setVariable": {
            "name": "victim",
            "value": ""
          }
        },
        {
          "setVariable": {
            "name": "saved",
            "value": ""
          }
        }
      ],
      "awake": "team:wolves",
      "sleepText": "Night {$var.night}. Eyes closed: the werewolves are awake.",
      "voice": "awake"
    },
    {
      "id": "seer",
      "name": "Night: the Seer",
      "actions": [
        "peek"
      ],
      "onEnter": [
        {
          "if": {
            "condition": {
              "compare": {
                "left": "$alive.role.seer",
                "op": "==",
                "right": 0
              }
            },
            "then": [
              {
                "endPhase": {}
              }
            ]
          }
        }
      ],
      "awake": "role:seer",
      "sleepText": "Night {$var.night}. Eyes closed: the Seer is awake.",
      "voice": "none"
    },
    {
      "id": "doctor",
      "name": "Night: the Doctor",
      "actions": [
        "protect"
      ],
      "onEnter": [
        {
          "if": {
            "condition": {
              "compare": {
                "left": "$alive.role.doctor",
                "op": "==",
                "right": 0
              }
            },
            "then": [
              {
                "endPhase": {}
              }
            ]
          }
        }
      ],
      "awake": "role:doctor",
      "sleepText": "Night {$var.night}. Eyes closed: the Doctor is awake.",
      "voice": "none"
    },
    {
      "id": "dawn",
      "name": "Dawn",
      "onEnter": [
        {
          "if": {
            "condition": {
              "and": [
                {
                  "not": {
                    "compare": {
                      "left": "$var.victim",
                      "op": "==",
                      "right": ""
                    }
                  }
                },
                {
                  "not": {
                    "compare": {
                      "left": "$var.victim",
                      "op": "==",
                      "right": "none"
                    }
                  }
                },
                {
                  "not": {
                    "compare": {
                      "left": "$var.victim",
                      "op": "==",
                      "right": "$var.saved"
                    }
                  }
                }
              ]
            },
            "then": [
              {
                "message": {
                  "text": "Dawn: {$var.victim.name} was found dead."
                }
              },
              {
                "eliminate": {
                  "seat": "$var.victim",
                  "revealRole": true
                }
              }
            ],
            "else": [
              {
                "message": {
                  "text": "Dawn: nobody died tonight."
                }
              }
            ]
          }
        }
      ],
      "advanceWhen": {
        "immediate": true
      }
    },
    {
      "id": "day",
      "name": "Day: talk and vote",
      "actions": [
        "lynch"
      ]
    }
  ],
  "actions": [
    {
      "id": "hunt",
      "name": "Choose the victim",
      "actor": "any",
      "vote": {
        "seats": true,
        "who": "team:wolves",
        "reveal": "result",
        "otherwise": "none",
        "onResult": [
          {
            "setVariable": {
              "name": "victim",
              "value": "$vote.result"
            }
          },
          {
            "endPhase": {}
          }
        ],
        "private": true
      }
    },
    {
      "id": "peek",
      "name": "Look at a card",
      "actor": "any",
      "params": [
        {
          "name": "target",
          "type": "seat"
        }
      ],
      "preconditions": [
        {
          "compare": {
            "left": "$actor.role",
            "op": "==",
            "right": "seer"
          }
        },
        {
          "not": {
            "compare": {
              "left": "$param.target",
              "op": "==",
              "right": "$actor.id"
            }
          }
        }
      ],
      "effects": [
        {
          "revealRole": {
            "seat": "$param.target",
            "to": "$actor",
            "teamOnly": true
          }
        },
        {
          "endPhase": {}
        }
      ]
    },
    {
      "id": "protect",
      "name": "Protect",
      "actor": "any",
      "params": [
        {
          "name": "target",
          "type": "seat"
        }
      ],
      "preconditions": [
        {
          "compare": {
            "left": "$actor.role",
            "op": "==",
            "right": "doctor"
          }
        }
      ],
      "effects": [
        {
          "setVariable": {
            "name": "saved",
            "value": "$param.target"
          }
        },
        {
          "endPhase": {}
        }
      ]
    },
    {
      "id": "lynch",
      "name": "Lynch",
      "actor": "any",
      "vote": {
        "seats": true,
        "otherwise": "none",
        "onResult": [
          {
            "if": {
              "condition": {
                "compare": {
                  "left": "$vote.result",
                  "op": "==",
                  "right": "none"
                }
              },
              "then": [
                {
                  "message": {
                    "text": "The village could not agree."
                  }
                }
              ],
              "else": [
                {
                  "eliminate": {
                    "seat": "$vote.result",
                    "revealRole": true
                  }
                }
              ]
            }
          },
          {
            "setVariable": {
              "name": "night",
              "delta": 1.0
            }
          },
          {
            "endTurn": {}
          }
        ]
      }
    }
  ],
  "winConditions": [
    {
      "team": "village",
      "when": {
        "compare": {
          "left": "$alive.team.wolves",
          "op": "==",
          "right": 0
        }
      },
      "winner": "$player"
    },
    {
      "team": "wolves",
      "when": {
        "compare": {
          "left": "$alive.team.wolves",
          "op": ">=",
          "right": "$alive.team.village"
        }
      },
      "winner": "$player"
    }
  ],
  "roles": {
    "teams": [
      {
        "id": "village",
        "name": "Villagers"
      },
      {
        "id": "wolves",
        "name": "Werewolves"
      }
    ],
    "list": [
      {
        "id": "seer",
        "name": "Seer",
        "team": "village",
        "description": "Each night, learns one player's side."
      },
      {
        "id": "doctor",
        "name": "Doctor",
        "team": "village",
        "optional": true,
        "description": "Each night, protects one player from the wolves."
      },
      {
        "id": "villager",
        "name": "Villager",
        "team": "village",
        "count": "fill"
      },
      {
        "id": "wolf",
        "name": "Werewolf",
        "team": "wolves",
        "count": "fill"
      }
    ],
    "byPlayers": {
