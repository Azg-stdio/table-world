  "game": {
    "id": "secret-dictator",
    "name": "Secret Dictator",
    "description": "Liberals and hidden fascists pass laws together. A president and a chancellor draw policies in secret and say what they like about them. Find the Dictator before it is too late.",
    "minPlayers": 5,
    "maxPlayers": 10
  },
  "variables": {
    "chancellor": "",
    "lastChancellor": "",
    "lastPresident": "",
    "tracker": 0
  },
  "turn": {
    "startingPlayer": "random",
    "phases": [
      "nominate",
      "election",
      "president",
      "chancellor",
      "execution"
    ]
  },
  "phases": [
    {
      "id": "nominate",
      "name": "Nominate a chancellor",
      "actions": [
        "nominate"
      ],
      "onEnter": [
        {
          "setVariable": {
            "name": "chancellor",
            "value": ""
          }
        },
        {
          "message": {
            "text": "{$current.name} is president: nominate a chancellor."
          }
        }
      ]
    },
    {
      "id": "election",
      "name": "Vote on the government",
      "actions": [
        "elect"
      ]
    },
    {
      "id": "president",
      "name": "The president discards",
      "actions": [
        "discard"
      ],
      "onEnter": [
        {
          "if": {
            "condition": {
              "zoneCount": {
                "zone": "policies",
                "op": "<",
                "value": 3
              }
            },
            "then": [
              {
                "move": {
                  "from": "discards",
                  "take": "all",
                  "count": 1,
                  "to": "policies",
                  "at": "top"
                }
              },
              {
                "shuffle": {
                  "object": "policies"
                }
              }
            ]
          }
        },
        {
          "move": {
            "from": "policies",
            "take": "top",
            "count": 3,
            "to": "$current.hand",
            "at": "top",
            "faceUp": true
          }
        }
      ]
    },
    {
      "id": "chancellor",
      "name": "The chancellor enacts",
      "actions": [
        "enact"
      ]
    },
    {
      "id": "execution",
      "name": "The president executes",
      "actions": [
        "execute"
      ]
    }
  ],
  "actions": [
    {
      "id": "nominate",
      "name": "Nominate",
      "params": [
        {
          "name": "candidate",
          "type": "seat"
        }
      ],
      "preconditions": [
        {
          "not": {
            "compare": {
              "left": "$param.candidate",
              "op": "==",
              "right": "$actor.id"
            }
          }
        },
        {
          "not": {
            "compare": {
              "left": "$param.candidate",
              "op": "==",
              "right": "$var.lastChancellor"
            }
          }
        },
        {
          "or": [
            {
              "compare": {
                "left": "$alive.count",
                "op": "<=",
                "right": 5
              }
            },
            {
              "not": {
                "compare": {
                  "left": "$param.candidate",
                  "op": "==",
                  "right": "$var.lastPresident"
                }
              }
            }
          ]
        }
      ],
      "effects": [
        {
          "setVariable": {
            "name": "chancellor",
            "value": "$param.candidate"
          }
        },
        {
          "message": {
            "text": "{$actor.name} nominates {$param.candidate.name}."
          }
        },
        {
          "endPhase": {}
        }
      ]
    },
    {
      "id": "elect",
      "name": "Vote",
      "actor": "any",
      "vote": {
        "options": [
          "yes",
          "no"
        ],
        "labels": {
          "yes": "Yes",
          "no": "No"
        },
        "decide": "majority",
        "otherwise": "no",
        "onResult": [
          {
            "if": {
              "condition": {
                "compare": {
                  "left": "$vote.result",
                  "op": "==",
                  "right": "yes"
                }
              },
              "then": [
                {
                  "setVariable": {
                    "name": "tracker",
                    "value": 0
                  }
                },
                {
                  "if": {
                    "condition": {
                      "and": [
                        {
                          "zoneCount": {
                            "zone": "fascist_track",
                            "op": ">=",
                            "value": 3
                          }
                        },
                        {
                          "compare": {
                            "left": "$var.chancellor.role",
                            "op": "==",
                            "right": "dictator"
                          }
                        }
                      ]
                    },
                    "then": [
                      {
                        "message": {
                          "text": "The Dictator is chancellor."
                        }
                      },
                      {
                        "win": {
                          "player": "",
                          "team": "fascists"
                        }
                      }
                    ],
                    "else": [
                      {
                        "gotoPhase": {
                          "phase": "president"
                        }
                      }
                    ]
                  }
                }
              ],
              "else": [
                {
                  "setVariable": {
                    "name": "tracker",
                    "delta": 1.0
                  }
                },
                {
                  "if": {
                    "condition": {
                      "compare": {
                        "left": "$var.tracker",
                        "op": ">=",
                        "right": 3
                      }
                    },
                    "then": [
                      {
                        "if": {
                          "condition": {
                            "zoneCount": {
                              "zone": "policies",
                              "op": "<",
                              "value": 3
                            }
                          },
                          "then": [
                            {
                              "move": {
                                "from": "discards",
                                "take": "all",
                                "count": 1,
                                "to": "policies",
                                "at": "top"
                              }
                            },
                            {
                              "shuffle": {
                                "object": "policies"
                              }
                            }
                          ]
                        }
                      },
                      {
                        "if": {
                          "condition": {
                            "compare": {
                              "left": "$obj.policies.top.meta.type",
                              "op": "==",
                              "right": "liberal"
                            }
                          },
                          "then": [
                            {
                              "move": {
                                "from": "policies",
                                "take": "top",
                                "count": 1,
                                "to": "liberal_track",
                                "at": "top",
                                "faceUp": true
                              }
                            }
                          ],
                          "else": [
                            {
                              "move": {
                                "from": "policies",
                                "take": "top",
                                "count": 1,
                                "to": "fascist_track",
                                "at": "top",
                                "faceUp": true
                              }
                            }
                          ]
                        }
                      },
                      {
                        "message": {
                          "text": "Chaos: the top policy is enacted."
                        }
                      },
                      {
                        "setVariable": {
                          "name": "tracker",
                          "value": 0
                        }
                      },
                      {
                        "setVariable": {
                          "name": "lastChancellor",
                          "value": ""
                        }
                      },
                      {
                        "setVariable": {
                          "name": "lastPresident",
                          "value": ""
                        }
                      }
                    ]
                  }
                },
                {
                  "endTurn": {}
                }
              ]
            }
          }
        ]
      }
    },
    {
      "id": "discard",
      "name": "Discard",
      "params": [
        {
          "name": "card",
          "filter": {
            "inZone": "$actor.hand"
          }
        }
      ],
      "effects": [
        {
          "move": {
            "object": "$param.card",
            "take": "top",
            "count": 1,
            "to": "discards",
            "at": "top",
            "faceUp": false
          }
        },
        {
          "move": {
            "from": "$actor.hand",
            "take": "all",
            "count": 1,
            "to": "$var.chancellor.hand",
            "at": "top",
            "faceUp": true
          }
        },
        {
          "endPhase": {}
        }
      ]
    },
    {
      "id": "enact",
      "name": "Enact",
      "actor": "any",
      "params": [
        {
          "name": "card",
          "filter": {
            "inZone": "$actor.hand"
          }
        }
      ],
      "preconditions": [
        {
          "compare": {
            "left": "$actor.id",
            "op": "==",
            "right": "$var.chancellor"
          }
        }
      ],
      "effects": [
        {
          "if": {
            "condition": {
              "compare": {
                "left": "$param.card.meta.type",
                "op": "==",
                "right": "liberal"
              }
            },
            "then": [
              {
                "move": {
                  "object": "$param.card",
                  "take": "top",
                  "count": 1,
                  "to": "liberal_track",
                  "at": "top",
                  "faceUp": true
                }
              },
              {
                "message": {
                  "text": "A liberal policy is enacted."
                }
              }
            ],
            "else": [
              {
                "move": {
                  "object": "$param.card",
                  "take": "top",
                  "count": 1,
                  "to": "fascist_track",
                  "at": "top",
                  "faceUp": true
                }
              },
              {
                "message": {
                  "text": "A fascist policy is enacted."
                }
              }
            ]
          }
        },
        {
          "move": {
            "from": "$actor.hand",
            "take": "all",
            "count": 1,
            "to": "discards",
            "at": "top",
            "faceUp": false
          }
        },
        {
          "setVariable": {
            "name": "lastChancellor",
            "value": "$actor.id"
          }
        },
        {
          "setVariable": {
            "name": "lastPresident",
            "value": "$current.id"
          }
        },
        {
          "if": {
            "condition": {
              "and": [
                {
                  "compare": {
                    "left": "$param.card.meta.type",
                    "op": "==",
                    "right": "fascist"
                  }
                },
                {
                  "or": [
                    {
                      "zoneCount": {
                        "zone": "fascist_track",
                        "op": "==",
                        "value": 4
                      }
                    },
                    {
                      "zoneCount": {
                        "zone": "fascist_track",
                        "op": "==",
                        "value": 5
                      }
                    }
                  ]
                }
              ]
            },
            "then": [
              {
                "gotoPhase": {
                  "phase": "execution"
                }
              }
            ],
            "else": [
              {
                "endTurn": {}
              }
            ]
          }
        }
      ]
    },
    {
      "id": "execute",
      "name": "Execute",
      "params": [
        {
          "name": "target",
          "type": "seat"
        }
      ],
      "preconditions": [
        {
          "not": {
            "compare": {
              "left": "$param.target",
              "op": "==",
              "right": "$actor.id"
            }
          }
        }
      ],
      "effects": [
        {
          "message": {
            "text": "{$actor.name} executes {$param.target.name}."
          }
        },
        {
          "if": {
            "condition": {
              "compare": {
                "left": "$param.target.role",
                "op": "==",
                "right": "dictator"
              }
            },
            "then": [
              {
                "revealRole": {
                  "seat": "$param.target"
                }
              },
              {
                "win": {
                  "player": "",
                  "team": "liberals"
                }
              }
            ],
            "else": [
              {
                "eliminate": {
                  "seat": "$param.target"
                }
              },
              {
                "endTurn": {}
              }
            ]
          }
        }
      ]
    }
  ],
  "events": {
    "onGameStart": [
      {
        "shuffle": {
          "object": "policies"
        }
      }
    ]
  },
  "winConditions": [
    {
      "team": "liberals",
      "when": {
        "zoneCount": {
          "zone": "liberal_track",
          "op": ">=",
          "value": 5
        }
      },
      "winner": "$player"
    },
    {
      "team": "fascists",
      "when": {
        "zoneCount": {
          "zone": "fascist_track",
          "op": ">=",
          "value": 6
        }
      },
      "winner": "$player"
    }
  ],
  "roles": {
    "teams": [
      {
        "id": "liberals",
        "name": "Liberals"
      },
      {
        "id": "fascists",
        "name": "Fascists"
