# =========================================================
# Unity project (lives in /unity)
# Based on https://github.com/github/gitignore/blob/main/Unity.gitignore
# Root-anchored paths are prefixed with /unity/ because the
# Unity project is not at the repo root.
# =========================================================
.utmp/
/unity/[Ll]ibrary/
/unity/[Tt]emp/
/unity/[Oo]bj/
/unity/[Bb]uild/
/unity/[Bb]uilds/
/unity/[Ll]ogs/
/unity/[Uu]ser[Ss]ettings/
/unity/[Mm]emoryCaptures/
/unity/[Rr]ecordings/
/unity/ServerData
/unity/UIElementsSchema/
# Screenshots from `unity command capture` (it always writes under Assets/)
/unity/[Aa]ssets/Temp/
/unity/[Aa]ssets/Temp.meta
# Unity CLI pipeline package: per-machine editor config (port, watchdog, play-mode overrides)
/unity/ProjectSettings/Packages/com.unity.pipeline/EditorPipelineConfig.json

# Blender backups
*.blend1
*.blend1.meta

# Autogenerated Jetbrains Rider plugin
/unity/[Aa]ssets/Plugins/Editor/JetBrains*

# Autogenerated VS/Rider solution and project files (Unity regenerates them).
# Scoped to /unity so the real core/ .csproj and .sln files are tracked.
/unity/*.csproj
/unity/*.sln
/unity/*.slnx
/unity/*.unityproj
/unity/*.booproj
/unity/ExportedObj/
/unity/.consulo/

# Unity generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports / Mono
sysinfo.txt
mono_crash.*
crashlytics-build.properties

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# TestRunner generated files
InitTestScene*.unity*
/unity/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Addressables
/unity/[Aa]ssets/StreamingAssets/aa*
/unity/[Aa]ssets/AddressableAssetsData/link.xml*
/unity/[Aa]ssets/Addressables_Temp*
/unity/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
/unity/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/unity/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/unity/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/unity/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated cache in Assets folder
/unity/[Aa]ssets/[Ss]ceneDependencyCache*

# =========================================================
# .NET (core/, core.tests/, mcp-server/, tools/)
# =========================================================
[Bb]in/
[Oo]bj/
TestResults/
*.nupkg

# =========================================================
# Editors / OS
# =========================================================
.vs/
.idea/
.gradle/
*.DotSettings.user
*.suo
*.user
*.userprefs
*.tmp
*.pdb
*.mdb
*.pidb
*.opendb
*.VC.db
*.svd
*.log
.DS_Store
Thumbs.db
