<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pure C# library. ZERO Unity dependencies.
    netstandard2.1 + C# 9 is what the Unity 6.6 compiler accepts.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>Core</AssemblyName>
    <RootNamespace>Core</RootNamespace>
    <!-- Lists package dlls in ReferenceCopyLocalPaths, so CopyToUnity can pick MoonSharp's and Concentus's. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <UnityPluginDir>$(MSBuildThisFileDirectory)..\unity\Assets\Plugins\Core\</UnityPluginDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Unity provides the same assembly through com.unity.nuget.newtonsoft-json 3.2.2. Do not copy it to Plugins. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- Sandboxed Lua (M5, ADR 0003). Unity has no package for it: its dll is copied to Plugins with Core.dll. -->
    <PackageReference Include="MoonSharp" Version="2.0.0" />
    <!-- Voice chat (T7.3): pure C# Opus, BSD licence, no dependencies. Copied to Plugins like MoonSharp. -->
    <PackageReference Include="Concentus" Version="1.1.7" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The interface's string tables (M9, ADR 0011), one per language, built into Core.dll so the engine and Unity read the same ones. -->
    <EmbeddedResource Include="Text\strings\*.json" LogicalName="Core.Text.strings.%(Filename).json" />
  </ItemGroup>

  <!--
    Unity consumes Core.dll from Assets/Plugins/Core/. Core.dll, MoonSharp.Interpreter.dll and Concentus.dll are copied; Newtonsoft comes from a Unity package.
    Debug only, so Release/CI builds never overwrite the committed dll.
  -->
  <Target Name="CopyToUnity" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug' And Exists('$(MSBuildThisFileDirectory)..\unity\Assets')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(UnityPluginDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ReferenceCopyLocalPaths)" DestinationFolder="$(UnityPluginDir)" SkipUnchangedFiles="true" Condition="'%(Filename)' == 'MoonSharp.Interpreter' Or '%(Filename)' == 'Concentus'" />
  </Target>

</Project>
