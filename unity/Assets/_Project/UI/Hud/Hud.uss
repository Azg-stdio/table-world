.hud {
    flex-grow: 1;
    padding: 12px;
}

.top-bar {
    flex-direction: row;
    align-items: center;
    padding: 6px 10px;
    border-radius: 6px;
    background-color: rgba(16, 18, 22, 0.82);
}

.turn-label {
    -unity-font-style: bold;
    font-size: 18px;
    color: rgb(240, 236, 226);
    margin-right: 16px;
}

.seat-list {
    flex-direction: row;
    flex-grow: 1;
}

.seat-chip {
    flex-direction: row;
    align-items: center;
    margin-right: 10px;
    padding: 2px 8px;
    border-radius: 10px;
    background-color: rgba(255, 255, 255, 0.06);
}

.seat-chip--local {
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 1px;
    border-color: rgba(240, 236, 226, 0.7);
}

/* Whose turn it is (rules or free-play turns): a warm outline. */
.seat-chip--turn {
    border-width: 2px;
    border-color: rgb(242, 196, 82);
    background-color: rgba(242, 196, 82, 0.16);
}

.seat-chip--local .seat-name {
    color: rgb(255, 252, 244);
    -unity-font-style: bold;
}

.seat-swatch {
    width: 12px;
    height: 12px;
    border-radius: 6px;
    margin-right: 6px;
    background-color: rgb(230, 230, 230);
}

.seat-swatch--red { background-color: rgb(219, 51, 46); }
.seat-swatch--blue { background-color: rgb(51, 107, 230); }
.seat-swatch--green { background-color: rgb(64, 191, 77); }
.seat-swatch--yellow { background-color: rgb(242, 217, 51); }
.seat-swatch--orange { background-color: rgb(242, 140, 38); }
.seat-swatch--purple { background-color: rgb(153, 77, 204); }
.seat-swatch--pink { background-color: rgb(242, 128, 179); }
.seat-swatch--teal { background-color: rgb(38, 179, 179); }
.seat-swatch--brown { background-color: rgb(128, 82, 46); }

.seat-name {
    font-size: 15px;
    color: rgb(220, 216, 206);
}

.hud-button {
    margin-left: 6px;
    padding: 4px 12px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    border-radius: 4px;
    background-color: rgb(46, 52, 62);
    color: rgb(240, 236, 226);
    font-size: 15px;
    transition-duration: 0.1s;
}

.hud-button:hover {
    background-color: rgb(66, 76, 92);
}

.hud-button:active {
    background-color: rgb(34, 38, 46);
}

.game-panel {
    align-self: center;
    max-width: 70%;
    margin-top: 8px;
    padding: 8px 10px;
    border-radius: 6px;
    background-color: rgba(16, 18, 22, 0.82);
}

.game-log {
    font-size: 15px;
    color: rgb(220, 216, 206);
    margin-bottom: 6px;
    white-space: normal;
}

.bottom-row {
    margin-top: auto;
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
}

.selection-panel {
    width: 300px;
    padding: 10px;
    border-radius: 6px;
    background-color: rgba(16, 18, 22, 0.82);
}

.selection-title {
    -unity-font-style: bold;
    font-size: 17px;
    color: rgb(240, 236, 226);
}

.selection-detail {
    font-size: 14px;
    color: rgb(170, 168, 160);
    margin-bottom: 8px;
    white-space: normal;
}

.actions {
    flex-direction: row;
    flex-wrap: wrap;
}

.actions .hud-button {
    margin: 0 6px 6px 0;
}

.status-label {
    max-width: 420px;
    padding: 6px 10px;
    border-radius: 4px;
    background-color: rgba(16, 18, 22, 0.7);
    font-size: 14px;
    color: rgb(220, 216, 206);
    white-space: normal;
}

.status-label--error {
    color: rgb(255, 150, 140);
}

.hidden {
    display: none;
}

.hud-button:disabled {
    opacity: 0.4;
}

.game-ui {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.game-ui-panel {
    position: absolute;
    min-width: 220px;
    padding: 10px;
    border-radius: 6px;
    background-color: rgba(16, 18, 22, 0.82);
}

.game-ui-panel--top-left { left: 12px; top: 64px; }
.game-ui-panel--top { left: 50%; top: 64px; translate: -50% 0; }
.game-ui-panel--top-right { right: 12px; top: 64px; }
.game-ui-panel--left { left: 12px; top: 50%; translate: 0 -50%; }
.game-ui-panel--center { left: 50%; top: 50%; translate: -50% -50%; }
.game-ui-panel--right { right: 12px; top: 50%; translate: 0 -50%; }
.game-ui-panel--bottom-left { left: 330px; bottom: 12px; }
.game-ui-panel--bottom { left: 50%; bottom: 12px; translate: -50% 0; }
.game-ui-panel--bottom-right { right: 12px; bottom: 48px; }

.game-ui-title {
    -unity-font-style: bold;
    font-size: 17px;
    color: rgb(240, 236, 226);
    margin-bottom: 6px;
}

.game-ui-label {
    font-size: 15px;
    color: rgb(220, 216, 206);
    margin-bottom: 4px;
    white-space: normal;
}

.game-ui-counter {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 4px;
}

.game-ui-counter-value {
    -unity-font-style: bold;
    font-size: 15px;
    color: rgb(240, 236, 226);
    margin-left: 12px;
}

.game-ui-panel .hud-button {
    margin: 4px 0 0 0;
}

.game-ui-image {
    width: 96px;
    height: 96px;
    -unity-background-scale-mode: scale-to-fit;
}

.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.box-rect {
    position: absolute;
    border-width: 1px;
    border-color: rgb(51, 217, 255);
    background-color: rgba(51, 217, 255, 0.12);
}

.tooltip {
    position: absolute;
    max-width: 320px;
    padding: 4px 8px;
    border-radius: 4px;
    background-color: rgba(16, 18, 22, 0.9);
    font-size: 15px;
    color: rgb(240, 236, 226);
    white-space: normal;
}

.look-panel {
    position: absolute;
    right: 24px;
    top: 50%;
    translate: 0 -50%;
    padding: 8px;
    border-radius: 6px;
    background-color: rgba(16, 18, 22, 0.9);
}

.look-image {
    width: 420px;
    height: 420px;
    -unity-background-scale-mode: scale-to-fit;
}

.look-caption {
    font-size: 15px;
    color: rgb(220, 216, 206);
    margin-top: 6px;
    -unity-text-align: middle-center;
}

.context-menu {
    position: absolute;
    min-width: 200px;
    padding: 6px;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    background-color: rgb(22, 24, 30);
}

.menu-title {
    -unity-font-style: bold;
    font-size: 15px;
    color: rgb(240, 236, 226);
    margin: 2px 4px 6px 4px;
}

.menu-section {
    font-size: 13px;
    color: rgb(150, 148, 140);
    margin: 6px 4px 2px 4px;
}

.menu-item {
    margin: 1px 0;
    padding: 3px 8px;
    border-width: 0;
    border-radius: 3px;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(230, 226, 216);
    font-size: 15px;
    -unity-text-align: middle-left;
}

.menu-item:hover {
    background-color: rgb(52, 60, 74);
}

.menu-row {
    flex-direction: row;
    flex-wrap: wrap;
}

.menu-row .menu-item {
    min-width: 34px;
    -unity-text-align: middle-center;
}

.menu-swatch {
    width: 22px;
    height: 22px;
    margin: 2px;
    border-radius: 3px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.3);
}

.menu-swatch--red { background-color: rgb(219, 51, 46); }
.menu-swatch--blue { background-color: rgb(51, 107, 230); }
.menu-swatch--green { background-color: rgb(64, 191, 77); }
.menu-swatch--yellow { background-color: rgb(242, 217, 51); }
.menu-swatch--white { background-color: rgb(240, 240, 240); }
.menu-swatch--black { background-color: rgb(40, 40, 44); }

.menu-field {
    margin: 2px 4px;
}

.search-panel {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 760px;
    height: 76%;
    padding: 10px;
    border-radius: 6px;
    background-color: rgb(22, 24, 30);
}

/* Fills the panel between title and button, and scrolls. */
.search-list {
    flex-grow: 1;
    flex-shrink: 1;
    margin-bottom: 8px;
    overflow: hidden;
}

.search-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

/* A card in the Search window: its face and its name; pressing it picks it up. */
.search-card {
    width: 96px;
    margin: 4px;
    padding: 3px;
    border-radius: 5px;
    background-color: rgba(255, 255, 255, 0.04);
}

.search-card:hover {
    background-color: rgba(255, 255, 255, 0.16);
}

.search-card-image {
    height: 126px;
    border-radius: 4px;
    background-color: rgb(250, 248, 240);
    -unity-background-scale-mode: stretch-to-fill;
}

.search-card-name {
    margin-top: 2px;
    font-size: 12px;
    color: rgb(220, 216, 206);
    -unity-text-align: middle-center;
    white-space: normal;
}

/* A bag item has no flat image: a name tile. */
.search-item {
    width: 140px;
    min-height: 44px;
    margin: 4px;
    padding: 6px;
    justify-content: center;
    border-radius: 5px;
    background-color: rgba(255, 255, 255, 0.06);
}

.search-item:hover {
    background-color: rgba(255, 255, 255, 0.16);
}

.menu-field .unity-base-text-field__input {
    min-height: 22px;
    padding: 2px 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    border-radius: 3px;
    background-color: rgb(36, 40, 48);
    color: rgb(240, 236, 226);
    font-size: 15px;
}

.net-address {
    width: 150px;
    margin-left: 8px;
}

.net-address .unity-base-text-field__input {
    min-height: 22px;
    padding: 2px 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    border-radius: 3px;
    background-color: rgb(36, 40, 48);
    color: rgb(240, 236, 226);
    font-size: 15px;
}

.hand-bar {
    position: absolute;
    bottom: 0;
    left: 50%;
    translate: -50% 0;
    height: 140px;
}

/* Resting cards show only their top (corner index and pip); the rest is below the screen edge. */
.hand-card {
    position: absolute;
    bottom: 0;
    width: 100px;
    height: 140px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.45);
    border-radius: 6px;
    background-color: rgb(250, 248, 240);
    -unity-background-scale-mode: stretch-to-fill;
    transform-origin: center bottom;
    translate: 0 84px;
    transition-duration: 0.12s;
}

.hand-card:hover {
    scale: 1.6 1.6;
    translate: 0 -6px;
    border-color: rgba(255, 255, 255, 0.9);
}

/* Hidden hand: a thin strip of each card stays visible; hovering still shows a card. */
.hand-bar--collapsed .hand-card {
    translate: 0 128px;
}

.hand-bar--collapsed .hand-card:hover {
    translate: 0 -6px;
}

.hand-toggle {
    position: absolute;
    bottom: 62px;
    left: 50%;
    translate: -50% 0;
    padding: 2px 10px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    border-radius: 4px;
    background-color: rgba(16, 18, 22, 0.82);
    color: rgb(240, 236, 226);
    font-size: 13px;
}

.hand-toggle:hover {
    background-color: rgb(66, 76, 92);
}

.hand-toggle--collapsed {
    bottom: 18px;
}

.help-panel {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 760px;
    height: 80%;
    padding: 14px 16px;
    border-radius: 6px;
    background-color: rgba(18, 20, 26, 0.96);
}

/* Title and button keep their size in the fixed-height panel; only the list gives way (and scrolls). */
.help-title {
    flex-shrink: 0;
    margin-bottom: 8px;
    -unity-font-style: bold;
    font-size: 19px;
    color: rgb(240, 236, 226);
}

.help-close {
    flex-shrink: 0;
    align-self: flex-end;
}

/* Fills the panel between title and button, and scrolls. */
.help-list {
    flex-grow: 1;
    flex-shrink: 1;
    margin-bottom: 10px;
    overflow: hidden;
}

/* Rows keep their height: the list scrolls instead of squeezing them. */
.help-group {
    flex-shrink: 0;
    margin-top: 10px;
    margin-bottom: 4px;
    -unity-font-style: bold;
    font-size: 16px;
    color: rgb(240, 236, 226);
}

.help-row {
    flex-shrink: 0;
    flex-direction: row;
    padding: 3px 0;
    border-bottom-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
}

.help-keys {
    width: 320px;
    flex-shrink: 0;
    font-size: 14px;
    color: rgb(250, 214, 140);
    white-space: normal;
}

.help-what {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 14px;
    color: rgb(220, 216, 206);
    white-space: normal;
}

/* Other players' names next to their pointers. */
.presence-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.presence-label {
    position: absolute;
    padding: 1px 6px;
    border-radius: 3px;
    background-color: rgba(16, 18, 22, 0.75);
    font-size: 13px;
    -unity-font-style: bold;
}
