.hud {
    flex-grow: 1;
    padding: 12px;
}

.top-bar {
    flex-direction: row;
    align-items: center;
    padding: 6px 10px;
    border-radius: 6px;
    background-color: rgba(16, 18, 22, 0.82);
}

/* A crowded bar squeezes the status texts (turn line, network), never the buttons, seats or address. */
.top-bar .hud-button,
.top-bar .seat-chip,
.top-bar .net-address {
    flex-shrink: 0;
    white-space: nowrap;
}

.net-status {
    flex-shrink: 1;
    min-width: 0;
    margin: 0 6px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.turn-label {
    flex-shrink: 1;
    min-width: 120px;
    max-width: 30%;
    -unity-font-style: bold;
    font-size: 18px;
    color: rgb(240, 236, 226);
    margin-right: 16px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.seat-list {
    flex-direction: row;
    flex-wrap: wrap;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.seat-chip {
    flex-direction: row;
    align-items: center;
    margin: 2px 10px 2px 0;
    padding: 2px 8px;
    border-radius: 10px;
    background-color: rgba(255, 255, 255, 0.06);
}

/* A card shown to everyone (ShowcaseView): big in the middle of every screen. */
.showcase {
    position: absolute;
    left: 0;
    right: 0;
    top: 12%;
    bottom: 12%;
    align-items: center;
    justify-content: center;
}

.showcase-face {
    flex-grow: 1;
    width: 60%;
    -unity-background-scale-mode: scale-to-fit;
}

.showcase-caption {
    margin-top: 8px;
    padding: 6px 14px;
    border-radius: 6px;
    background-color: rgba(16, 18, 22, 0.88);
    font-size: 18px;
    color: rgb(255, 252, 244);
}

/* The pocket calculator (CalculatorPanel), under the top bar on the right. */
.calculator {
    position: absolute;
    top: 38%;
    left: 120px;
    width: 220px;
    padding: 10px;
    border-radius: 8px;
    background-color: rgba(16, 18, 22, 0.94);
}

.calculator-history {
    min-height: 18px;
    font-size: 14px;
    -unity-text-align: middle-right;
    color: rgb(170, 166, 156);
}

.calculator-display {
    margin-bottom: 8px;
    padding: 4px 8px;
    border-radius: 4px;
    background-color: rgb(30, 34, 40);
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    color: rgb(255, 252, 244);
}

.calculator-row {
    flex-direction: row;
}

.calculator-key {
    flex-grow: 1;
    height: 38px;
    margin: 2px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 4px;
    background-color: rgb(46, 52, 62);
    font-size: 18px;
    -unity-text-align: middle-center;
    color: rgb(240, 236, 226);
}

.calculator-key--op {
    background-color: rgb(84, 70, 40);
}

/* Dice zones (DiceTotalsView): the total over the zone, each player's share under it. */
.dice-totals {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.dice-total {
    position: absolute;
    translate: -50% -100%;
    align-items: center;
    padding: 4px 12px;
    border-radius: 8px;
    background-color: rgba(16, 18, 22, 0.82);
}

.dice-total-sum {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(255, 252, 244);
}

.dice-total-seats {
    flex-direction: row;
}

.dice-total-seat {
    flex-direction: row;
    align-items: center;
    margin: 0 4px;
}

.dice-total-value {
    font-size: 16px;
    color: rgb(240, 236, 226);
}

/* The choices of one game action (ActionPicker): cards show their faces. */
.action-picker {
    position: absolute;
    left: 15%;
    right: 15%;
    bottom: 22%;
    max-height: 60%;
    padding: 12px 14px;
    border-radius: 8px;
    background-color: rgba(16, 18, 22, 0.94);
}

.action-picker-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.action-picker-title {
    flex-grow: 1;
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(240, 236, 226);
}

.action-picker-scroll {
    flex-shrink: 1;
}

.action-picker-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.action-choice {
    margin: 4px;
    padding: 6px 12px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    border-radius: 6px;
    background-color: rgb(46, 52, 62);
    color: rgb(240, 236, 226);
    font-size: 15px;
}

.action-choice:hover {
    border-color: rgb(242, 196, 82);
}

.action-choice--card {
    width: 132px;
    padding: 6px 6px 10px 6px;
    align-items: center;
}

.action-choice-image {
    width: 120px;
    height: 168px;
    margin-bottom: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

.action-choice-label {
    white-space: normal;
    -unity-text-align: middle-center;
}

.seat-chip--out {
    opacity: 0.4;
}

.seat-chip--local {
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 1px;
    border-color: rgba(240, 236, 226, 0.7);
}

/* A seat you can click to sit at (G10). */
.seat-chip--free:hover {
    background-color: rgba(255, 255, 255, 0.18);
}

/* Someone else's seat. */
.seat-chip--taken {
    opacity: 0.75;
}

/* Whose turn it is (rules or free-play turns): a warm outline. */
.seat-chip--turn {
    border-width: 2px;
    border-color: rgb(242, 196, 82);
    background-color: rgba(242, 196, 82, 0.16);
}

.seat-chip--local .seat-name {
    color: rgb(255, 252, 244);
    -unity-font-style: bold;
}

.seat-swatch {
    width: 12px;
    height: 12px;
    border-radius: 6px;
    margin-right: 6px;
    background-color: rgb(230, 230, 230);
}

.seat-swatch--red { background-color: rgb(219, 51, 46); }
.seat-swatch--blue { background-color: rgb(51, 107, 230); }
.seat-swatch--green { background-color: rgb(64, 191, 77); }
.seat-swatch--yellow { background-color: rgb(242, 217, 51); }
.seat-swatch--orange { background-color: rgb(242, 140, 38); }
.seat-swatch--purple { background-color: rgb(153, 77, 204); }
.seat-swatch--pink { background-color: rgb(242, 128, 179); }
.seat-swatch--teal { background-color: rgb(38, 179, 179); }
.seat-swatch--brown { background-color: rgb(128, 82, 46); }
.seat-swatch--lime { background-color: rgb(166, 217, 38); }
.seat-swatch--maroon { background-color: rgb(128, 20, 38); }

.seat-name {
    font-size: 15px;
    color: rgb(220, 216, 206);
}

.hud-button {
    margin-left: 6px;
    padding: 4px 12px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    border-radius: 4px;
    background-color: rgb(46, 52, 62);
    color: rgb(240, 236, 226);
    font-size: 15px;
    transition-duration: 0.1s;
}

.hud-button:hover {
    background-color: rgb(66, 76, 92);
}

.hud-button:active {
    background-color: rgb(34, 38, 46);
}

.game-panel {
    align-self: center;
    /* Between a game's top-left and top-right panels (30% each). */
    max-width: 38%;
    margin-top: 8px;
    padding: 8px 10px;
    border-radius: 6px;
    background-color: rgba(16, 18, 22, 0.82);
}

.game-log {
    font-size: 15px;
    color: rgb(220, 216, 206);
    margin-bottom: 6px;
    white-space: normal;
}

.bottom-row {
    margin-top: auto;
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
}

.selection-panel {
    width: 300px;
    padding: 10px;
    border-radius: 6px;
    background-color: rgba(16, 18, 22, 0.82);
}

.selection-title {
    -unity-font-style: bold;
    font-size: 17px;
    color: rgb(240, 236, 226);
}

.selection-detail {
    font-size: 14px;
    color: rgb(170, 168, 160);
    margin-bottom: 8px;
    white-space: normal;
}

.actions {
    flex-direction: row;
    flex-wrap: wrap;
}

/* A blind round is running: the button reveals it. */
.hud-button--blind {
    border-color: rgb(242, 196, 82);
    background-color: rgba(242, 196, 82, 0.25);
    -unity-font-style: bold;
}

.actions .hud-button {
    margin: 0 6px 6px 0;
}

.status-label {
    max-width: 420px;
    padding: 6px 10px;
    border-radius: 4px;
    background-color: rgba(16, 18, 22, 0.7);
    font-size: 14px;
    color: rgb(220, 216, 206);
    white-space: normal;
}

.status-label--error {
    color: rgb(255, 150, 140);
}

.hidden {
    display: none;
}

.hud-button:disabled {
    opacity: 0.4;
}

.game-ui {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.game-ui-panel {
    position: absolute;
    min-width: 220px;
    max-width: 30%;
    padding: 10px;
    border-radius: 6px;
    background-color: rgba(16, 18, 22, 0.82);
}

/* Under the top bar, which can wrap to two rows of seats. */
.game-ui-panel--top-left { left: 12px; top: 92px; }
.game-ui-panel--top { left: 50%; top: 92px; translate: -50% 0; }
.game-ui-panel--top-right { right: 12px; top: 92px; }
.game-ui-panel--left { left: 12px; top: 50%; translate: 0 -50%; }
.game-ui-panel--center { left: 50%; top: 50%; translate: -50% -50%; }
.game-ui-panel--right { right: 12px; top: 50%; translate: 0 -50%; }
.game-ui-panel--bottom-left { left: 424px; bottom: 12px; }
.game-ui-panel--bottom { left: 50%; bottom: 12px; translate: -50% 0; }
.game-ui-panel--bottom-right { right: 12px; bottom: 48px; }

/* While the hand bar shows cards, the bottom panels stand above it (the bar is up to 30% of the screen tall). */
.hand-showing .game-ui-panel--bottom-left,
.hand-showing .game-ui-panel--bottom,
.hand-showing .game-ui-panel--bottom-right {
    bottom: 33%;
}

.game-ui-title {
    -unity-font-style: bold;
    font-size: 17px;
    color: rgb(240, 236, 226);
    margin-bottom: 6px;
}

.game-ui-label {
    font-size: 15px;
    color: rgb(220, 216, 206);
    margin-bottom: 4px;
    white-space: normal;
}

.game-ui-counter {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 4px;
}

.game-ui-counter-value {
    -unity-font-style: bold;
    font-size: 15px;
    color: rgb(240, 236, 226);
    margin-left: 12px;
}

.game-ui-panel .hud-button {
    margin: 4px 0 0 0;
}

.game-ui-image {
    width: 96px;
    height: 96px;
    -unity-background-scale-mode: scale-to-fit;
}

.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.box-rect {
    position: absolute;
    border-width: 1px;
    border-color: rgb(51, 217, 255);
    background-color: rgba(51, 217, 255, 0.12);
}

.tooltip {
    position: absolute;
    max-width: 320px;
    padding: 4px 8px;
    border-radius: 4px;
    background-color: rgba(16, 18, 22, 0.9);
    font-size: 15px;
    color: rgb(240, 236, 226);
    white-space: normal;
}

.look-panel {
    position: absolute;
    right: 24px;
    top: 50%;
    translate: 0 -50%;
    padding: 8px;
    border-radius: 6px;
    background-color: rgba(16, 18, 22, 0.9);
}

.look-image {
    width: 420px;
    height: 420px;
    -unity-background-scale-mode: scale-to-fit;
}

.look-caption {
    font-size: 15px;
    color: rgb(220, 216, 206);
    margin-top: 6px;
    -unity-text-align: middle-center;
}

.context-menu {
    position: absolute;
    min-width: 200px;
    padding: 6px;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    background-color: rgb(22, 24, 30);
}

/* Entries keep their height; the menu moves to stay on screen instead of squeezing them. */
.context-menu > * {
    flex-shrink: 0;
}

.menu-title {
    -unity-font-style: bold;
    font-size: 15px;
    color: rgb(240, 236, 226);
    margin: 2px 4px 6px 4px;
}

.menu-section {
    font-size: 13px;
    color: rgb(150, 148, 140);
    margin: 6px 4px 2px 4px;
}

.menu-item {
    margin: 1px 0;
    padding: 3px 8px;
    border-width: 0;
    border-radius: 3px;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(230, 226, 216);
    font-size: 15px;
    -unity-text-align: middle-left;
}

.menu-item:hover {
    background-color: rgb(52, 60, 74);
}

.menu-row {
    flex-direction: row;
    flex-wrap: wrap;
}

.menu-row .menu-item {
    min-width: 34px;
    -unity-text-align: middle-center;
}

.menu-swatch {
    width: 22px;
    height: 22px;
    margin: 2px;
    border-radius: 3px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.3);
}

.menu-swatch--red { background-color: rgb(219, 51, 46); }
.menu-swatch--blue { background-color: rgb(51, 107, 230); }
.menu-swatch--green { background-color: rgb(64, 191, 77); }
.menu-swatch--yellow { background-color: rgb(242, 217, 51); }
.menu-swatch--white { background-color: rgb(240, 240, 240); }
.menu-swatch--black { background-color: rgb(40, 40, 44); }

.menu-field {
    margin: 2px 4px;
}

.search-panel {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 760px;
    height: 76%;
    padding: 10px;
    border-radius: 6px;
    background-color: rgb(22, 24, 30);
}

/* Fills the panel between title and button, and scrolls. */
.search-list {
    flex-grow: 1;
    flex-shrink: 1;
    margin-bottom: 8px;
    overflow: hidden;
}

.search-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

/* A card in the Search window: its face and its name; pressing it picks it up. */
.search-card {
    width: 96px;
    margin: 4px;
    padding: 3px;
    border-radius: 5px;
    background-color: rgba(255, 255, 255, 0.04);
}

.search-card:hover {
    background-color: rgba(255, 255, 255, 0.16);
}

.search-card-image {
    height: 126px;
    border-radius: 4px;
    background-color: rgb(250, 248, 240);
    -unity-background-scale-mode: stretch-to-fill;
}

.search-card-name {
    margin-top: 2px;
    font-size: 12px;
    color: rgb(220, 216, 206);
    -unity-text-align: middle-center;
    white-space: normal;
}

/* A bag item has no flat image: a name tile. */
.search-item {
    width: 140px;
    min-height: 44px;
    margin: 4px;
    padding: 6px;
    justify-content: center;
    border-radius: 5px;
    background-color: rgba(255, 255, 255, 0.06);
}

.search-item:hover {
    background-color: rgba(255, 255, 255, 0.16);
}

.menu-field .unity-base-text-field__input {
    min-height: 22px;
    padding: 2px 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    border-radius: 3px;
    background-color: rgb(36, 40, 48);
    color: rgb(240, 236, 226);
    font-size: 15px;
}

.net-address {
    width: 150px;
    margin-left: 8px;
}

.net-address .unity-base-text-field__input {
    min-height: 22px;
    padding: 2px 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    border-radius: 3px;
    background-color: rgb(36, 40, 48);
    color: rgb(240, 236, 226);
    font-size: 15px;
}

/* The hand drawer: its height, bottom (how far it is open), width and the cards' sizes and places come from code. */
.hand-bar {
    position: absolute;
    left: 50%;
    translate: -50% 0;
    transition-duration: 0.12s;
}

.hand-card {
    position: absolute;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.45);
    border-radius: 8px;
    background-color: rgb(250, 248, 240);
    -unity-background-scale-mode: stretch-to-fill;
    transform-origin: center bottom;
    transition-duration: 0.12s;
}

.hand-card:hover {
    scale: 1.12 1.12;
    border-color: rgba(255, 255, 255, 0.9);
}

/* The drawer's handle: drag it to open or shut the hand, click to flip. Its height above the cards comes from code. */
/* The hand's slider (HandBar): how much of the hand shows, from whole cards (top) to hidden (bottom). */
.hand-slider {
    position: absolute;
    width: 12px;
    border-radius: 6px;
    background-color: rgba(16, 18, 22, 0.75);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.18);
}

.hand-slider-thumb {
    position: absolute;
    left: -6px;
    width: 22px;
    height: 22px;
    border-radius: 11px;
    background-color: rgb(242, 196, 82);
    border-width: 2px;
    border-color: rgb(30, 26, 18);
}

.hand-slider:hover .hand-slider-thumb {
    background-color: rgb(255, 214, 110);
}

/* With the hand hidden, the slider stays in view to bring it back. */
.hand-slider--hidden-hand {
    background-color: rgba(16, 18, 22, 0.9);
}

.hand-toggle {
    position: absolute;
    left: 50%;
    translate: -50% 0;
    padding: 2px 14px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    border-radius: 4px;
    background-color: rgba(16, 18, 22, 0.82);
    color: rgb(240, 236, 226);
    font-size: 13px;
    transition-duration: 0.12s;
}

.hand-toggle:hover {
    background-color: rgb(66, 76, 92);
}

.hand-toggle--collapsed {
    background-color: rgba(16, 18, 22, 0.65);
}

.help-panel {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 760px;
    height: 80%;
    padding: 14px 16px;
    border-radius: 6px;
    background-color: rgb(18, 20, 26);
}

/* Title and button keep their size in the fixed-height panel; only the list gives way (and scrolls). */
.help-title {
    flex-shrink: 0;
    margin-bottom: 8px;
    -unity-font-style: bold;
    font-size: 19px;
    color: rgb(240, 236, 226);
}

.help-close {
    flex-shrink: 0;
    align-self: flex-end;
}

/* Fills the panel between title and button, and scrolls. */
.help-list {
    flex-grow: 1;
    flex-shrink: 1;
    margin-bottom: 10px;
    overflow: hidden;
}

/* Rows keep their height: the list scrolls instead of squeezing them. */
.help-group {
    flex-shrink: 0;
    margin-top: 10px;
    margin-bottom: 4px;
    -unity-font-style: bold;
    font-size: 16px;
    color: rgb(240, 236, 226);
}

.help-row {
    flex-shrink: 0;
    flex-direction: row;
    padding: 3px 0;
    border-bottom-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
}

.help-keys {
    width: 320px;
    flex-shrink: 0;
    font-size: 14px;
    color: rgb(250, 214, 140);
    white-space: normal;
}

.help-what {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 14px;
    color: rgb(220, 216, 206);
    white-space: normal;
}

/* Other players' names next to their pointers. */
.presence-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.presence-label {
    position: absolute;
    padding: 1px 6px;
    border-radius: 3px;
    background-color: rgba(16, 18, 22, 0.75);
    font-size: 13px;
    -unity-font-style: bold;
}

/* Chat and selection stack at the bottom left. */
.left-column {
    align-items: flex-start;
}

/* Chat and game log (G11). Closed: only recent lines, each on its own dark strip; open: scrollback, tabs and input. */
.chat-panel {
    width: 400px;
    margin-bottom: 8px;
    padding: 4px;
    border-radius: 6px;
}

.chat-panel--open {
    background-color: rgba(16, 18, 22, 0.86);
}

.chat-tabs {
    display: none;
    flex-direction: row;
    margin-bottom: 4px;
}

.chat-panel--open .chat-tabs {
    display: flex;
}

.chat-tab {
    margin: 0 4px 0 0;
    padding: 2px 12px;
    border-width: 0;
    border-bottom-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(170, 168, 160);
    font-size: 14px;
}

.chat-tab:hover {
    color: rgb(240, 236, 226);
}

.chat-tab--active {
    border-color: rgb(242, 196, 82);
    color: rgb(240, 236, 226);
    -unity-font-style: bold;
}

.chat-list {
    max-height: 150px;
}

.chat-panel--open .chat-list {
    height: 240px;
    max-height: none;
}

.chat-row {
    flex-shrink: 0;
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 2px;
    padding: 2px 6px;
    border-radius: 3px;
    background-color: rgba(16, 18, 22, 0.66);
}

.chat-panel--open .chat-row {
    background-color: rgba(0, 0, 0, 0);
}

.chat-from {
    flex-shrink: 0;
    margin-right: 6px;
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(240, 236, 226);
}

.chat-text {
    flex-shrink: 1;
    flex-grow: 1;
    font-size: 14px;
    color: rgb(230, 226, 216);
    white-space: normal;
}

.chat-text--roll {
    color: rgb(250, 214, 140);
}

.chat-text--notice {
    color: rgb(170, 200, 230);
    -unity-font-style: italic;
}

.chat-text--action {
    color: rgb(160, 158, 150);
    font-size: 13px;
}

.chat-hint {
    align-self: flex-start;
    padding: 2px 8px;
    border-radius: 3px;
    background-color: rgba(16, 18, 22, 0.5);
    font-size: 13px;
    color: rgb(150, 148, 140);
}

/* Typing into a script's input on an object (M5): opens at the pointer. */
.script-input-editor {
    position: absolute;
    min-width: 220px;
    margin: 0;
}

.script-input-editor .unity-base-text-field__input {
    min-height: 26px;
    padding: 2px 6px;
    background-color: rgb(250, 250, 250);
    color: rgb(30, 30, 34);
    border-width: 1px;
    border-color: rgb(80, 140, 230);
    border-radius: 3px;
}

.chat-input {
    display: none;
    margin: 4px 0 0 0;
}

.chat-panel--open .chat-input {
    display: flex;
}

.chat-input .unity-base-text-field__input {
    min-height: 24px;
    padding: 2px 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    border-radius: 3px;
    background-color: rgb(36, 40, 48);
    color: rgb(240, 236, 226);
    font-size: 15px;
}

/* Escape menu (G13): a short column of large buttons in the middle of the screen. */
.escape-panel {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 320px;
    padding: 16px 18px;
    border-radius: 6px;
    background-color: rgba(18, 20, 26, 0.96);
}

.escape-title {
    -unity-text-align: middle-center;
    margin-bottom: 12px;
}

.escape-button {
    margin: 0 0 8px 0;
    -unity-text-align: middle-center;
    padding: 8px 12px;
    font-size: 17px;
}

.escape-confirm {
    margin-top: 4px;
    padding-top: 10px;
    border-top-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
}

.escape-confirm-row {
    flex-direction: row;
    justify-content: flex-end;
}

.escape-danger {
    background-color: rgb(150, 52, 46);
}

.escape-danger:hover {
    background-color: rgb(182, 66, 58);
}

/* Settings (G31): one row per setting, label on the left, control on the right. */
.settings-panel {
    width: 640px;
}

.settings-row {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    min-height: 34px;
    padding: 2px 0;
    border-bottom-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
}

.settings-label {
    flex-grow: 1;
    font-size: 15px;
    color: rgb(220, 216, 206);
}

.settings-slider {
    width: 220px;
    margin: 0 8px 0 0;
}

.settings-slider .unity-base-slider__tracker {
    height: 4px;
    margin-top: -2px;
    border-width: 0;
    border-radius: 2px;
    background-color: rgba(255, 255, 255, 0.18);
}

.settings-slider .unity-base-slider__dragger {
    width: 16px;
    height: 16px;
    margin-top: -8px;
    border-width: 0;
    border-radius: 8px;
    background-color: rgb(242, 196, 82);
}

.settings-slider .unity-base-slider__dragger-border {
    display: none;
}

.settings-value {
    width: 56px;
    font-size: 14px;
    color: rgb(250, 214, 140);
    -unity-text-align: middle-right;
}

.settings-step {
    width: 30px;
    margin: 0;
    padding: 2px 0;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    border-radius: 4px;
    background-color: rgb(46, 52, 62);
    color: rgb(240, 236, 226);
    font-size: 18px;
    -unity-text-align: middle-center;
}

.settings-step:hover {
    background-color: rgb(66, 76, 92);
}

.settings-choice {
    width: 200px;
    font-size: 14px;
    color: rgb(250, 214, 140);
    -unity-text-align: middle-center;
}

/* A key in the Keys group: click it, then press the new key. */
.settings-key {
    width: 260px;
    margin: 0;
    font-size: 14px;
    color: rgb(250, 214, 140);
    -unity-text-align: middle-center;
}

.settings-note {
    flex-shrink: 0;
    margin-top: 10px;
    font-size: 13px;
    color: rgb(150, 148, 140);
    white-space: normal;
}

.settings-buttons {
    flex-shrink: 0;
    flex-direction: row;
    justify-content: space-between;
}

.settings-text {
    width: 286px;
    margin: 0;
}

.settings-text .unity-base-text-field__input {
    min-height: 24px;
    padding: 2px 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    border-radius: 3px;
    background-color: rgb(36, 40, 48);
    color: rgb(240, 236, 226);
    font-size: 15px;
}

/* Players (G23): one row per participant; the host's buttons on the right. */
.players-panel {
    width: 760px;
}

.player-row {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    min-height: 34px;
    padding: 2px 4px;
    border-bottom-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
}

.player-name {
    width: 170px;
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(240, 236, 226);
}

.player-badges {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 13px;
    color: rgb(170, 168, 160);
    white-space: normal;
}

.player-actions {
    flex-direction: row;
    flex-shrink: 0;
}

.player-action {
    margin-left: 4px;
    padding: 2px 8px;
    font-size: 13px;
}

.player-danger {
    background-color: rgb(150, 52, 46);
}

.player-danger:hover {
    background-color: rgb(182, 66, 58);
}

.seat-swatch--none {
    background-color: rgba(255, 255, 255, 0.15);
}

/* Left-button tools (G28): a column at the left edge; the active one is lit. */
.tool-bar {
    position: absolute;
    left: 12px;
    top: 38%;
    padding: 4px;
    border-radius: 6px;
    background-color: rgba(16, 18, 22, 0.82);
}

.tool-button {
    margin: 2px 0;
    padding: 4px 10px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 4px;
    background-color: rgb(46, 52, 62);
    color: rgb(220, 216, 206);
    font-size: 14px;
}

.tool-button:hover {
    background-color: rgb(66, 76, 92);
}

/* Table tools that are not pointer modes (blind round, calculator) start a little apart. */
.tool-button--gap {
    margin-top: 10px;
}

.tool-button--active {
    border-color: rgb(242, 196, 82);
    background-color: rgba(242, 196, 82, 0.25);
    color: rgb(255, 252, 244);
    -unity-font-style: bold;
}

/* Save and load (G30). */
.saves-new {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.saves-name-field {
    flex-grow: 1;
    width: auto;
    margin-right: 6px;
}

.saves-row {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    min-height: 40px;
    padding: 3px 0;
    border-bottom-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
}

.saves-text {
    flex-grow: 1;
    flex-shrink: 1;
}

.saves-name {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(240, 236, 226);
}

.saves-detail {
    font-size: 13px;
    color: rgb(170, 168, 160);
}

/* Gizmo (G28): exact position, beside the tool bar. */
.gizmo-panel {
    position: absolute;
    left: 90px;
    top: 30%;
    width: 300px;
    padding: 10px 12px;
    border-radius: 6px;
    background-color: rgb(18, 20, 26);
}

.gizmo-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.gizmo-label {
    flex-grow: 1;
    font-size: 14px;
    color: rgb(220, 216, 206);
}

.gizmo-field {
    width: 110px;
}

/* Blindfold (G15): the whole screen goes dark except the chat and the top bar. */
.blindfold {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgb(4, 4, 6);
}

.blindfold-text {
    font-size: 20px;
    color: rgb(150, 148, 140);
}

/* Notebook (G25): pages on the left, the open page on the right. */
.notes-panel {
    width: 860px;
}

.notes-body {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: row;
    margin-bottom: 10px;
}

.notes-tabs-column {
    width: 200px;
    margin-right: 12px;
}

.notes-tabs {
    flex-grow: 1;
    flex-shrink: 1;
    margin-bottom: 6px;
}

.notes-tab {
    flex-shrink: 0;
    margin: 1px 0;
    padding: 4px 8px;
    border-width: 0;
    border-left-width: 3px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.04);
    color: rgb(220, 216, 206);
    font-size: 14px;
    -unity-text-align: middle-left;
}

.notes-tab:hover {
    background-color: rgba(255, 255, 255, 0.12);
}

.notes-tab--open {
    border-color: rgb(242, 196, 82);
    background-color: rgba(242, 196, 82, 0.18);
    color: rgb(255, 252, 244);
}

.notes-tab--private {
    -unity-font-style: italic;
}

.notes-editor {
    flex-grow: 1;
    flex-shrink: 1;
}

.notes-title {
    width: auto;
    margin-bottom: 6px;
}

.notes-text {
    flex-grow: 1;
    flex-shrink: 1;
    width: auto;
    margin-bottom: 6px;
}

.notes-text .unity-base-text-field__input {
    flex-grow: 1;
    -unity-text-align: upper-left;
    white-space: normal;
}

.notes-row {
    flex-direction: row;
    justify-content: space-between;
}

/* A seat whose player is talking (T7.3). */
.seat-chip--talking {
    border-width: 1px;
    border-color: rgb(110, 200, 120);
    background-color: rgba(110, 200, 120, 0.22);
}

/* The emote wheel (T7.4): labels on a ring around the screen centre, the pointed one lit. */
.emote-wheel {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.emote-wheel__ring {
    width: 380px;
    height: 380px;
    border-radius: 190px;
    background-color: rgba(16, 18, 22, 0.72);
    align-items: center;
    justify-content: center;
}

.emote-wheel__center {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(240, 236, 226);
}

.emote-wheel__item {
    position: absolute;
    translate: -50% -50%;
    padding: 4px 10px;
    border-radius: 12px;
    font-size: 15px;
    color: rgb(240, 236, 226);
    background-color: rgb(46, 52, 62);
}

.emote-wheel__item:hover,
.emote-wheel__item--hover {
    color: rgb(30, 26, 18);
    background-color: rgb(242, 196, 82);
}

/* Reading a PDF (M7 T8.8): the page fills the window above a bar of controls. */
.pdf-reader {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding: 24px 24px 12px 24px;
    background-color: rgba(10, 11, 14, 0.92);
}

.pdf-reader__page {
    flex-grow: 1;
    -unity-background-scale-mode: scale-to-fit;
}

.pdf-reader__bar {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-top: 10px;
}

.pdf-reader__number {
    margin: 0 12px;
    font-size: 15px;
    color: rgb(240, 236, 226);
}

/* An action under a game in the Games list (download its missing files, re-import it). */
.menu-item--sub {
    margin-left: 18px;
    font-size: 13px;
    color: rgb(250, 214, 140);
}

/* Loading screen: covers the table while a game loads and its images arrive. */
.loading-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgb(16, 18, 22);
}

.loading-card {
    width: 520px;
    max-width: 90%;
    align-items: stretch;
}

.loading-title {
    margin-bottom: 18px;
    -unity-font-style: bold;
    font-size: 26px;
    -unity-text-align: middle-center;
    white-space: normal;
    color: rgb(240, 236, 226);
}

.loading-step {
    margin-bottom: 8px;
    font-size: 16px;
    color: rgb(200, 196, 188);
}

.loading-bar {
    height: 10px;
    margin: 0;
}

.loading-bar .unity-progress-bar__container {
    flex-grow: 1;
}

.loading-bar .unity-progress-bar__background {
    flex-grow: 1;
    border-width: 0;
    border-radius: 5px;
    background-color: rgb(40, 44, 52);
}

/* Our theme leaves out Unity's runtime theme, which is what places a ProgressBar's fill: place it here. */
.loading-bar .unity-progress-bar__progress {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    border-radius: 5px;
    background-color: rgb(51, 217, 255);
}

.loading-bar .unity-progress-bar__title-container {
    display: none;
}

.loading-detail {
    margin-top: 8px;
    font-size: 13px;
    color: rgb(150, 156, 166);
}

.loading-skip {
    align-self: center;
    margin: 18px 0 0 0;
}

/* Connect an AI agent: the setup lines to copy, one block per agent. */
.agent-intro {
    margin-top: 0;
    white-space: normal;
}

.agent-status {
    margin: 10px 0 4px 0;
    font-size: 14px;
    color: rgb(250, 214, 140);
    white-space: normal;
}

.agent-status--ok {
    color: rgb(140, 220, 170);
}

.agent-block {
    flex-direction: row;
    align-items: flex-start;
    flex-shrink: 0;
    margin-bottom: 4px;
}

.agent-code {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    padding: 8px 10px;
    border-radius: 4px;
    background-color: rgb(12, 14, 18);
    color: rgb(220, 226, 232);
    font-size: 13px;
    white-space: pre-wrap;
}

.agent-copy {
    flex-shrink: 0;
    margin-left: 8px;
}
