<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="Hud.uss" />
    <ui:VisualElement name="root" class="hud" picking-mode="Ignore">
        <ui:VisualElement name="gameUi" class="game-ui" picking-mode="Ignore" />
        <ui:VisualElement name="presenceLayer" class="presence-layer" picking-mode="Ignore" />
        <ui:VisualElement name="overlay" class="overlay" picking-mode="Ignore">
            <ui:VisualElement name="boxRect" class="box-rect hidden" picking-mode="Ignore" />
            <ui:Label name="tooltip" class="tooltip hidden" picking-mode="Ignore" />
            <ui:Label name="measure" class="tooltip hidden" picking-mode="Ignore" />
            <ui:VisualElement name="lookPanel" class="look-panel hidden" picking-mode="Ignore">
                <ui:VisualElement name="lookImage" class="look-image" picking-mode="Ignore" />
                <ui:Label name="lookCaption" class="look-caption" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="searchPanel" class="search-panel hidden">
                <ui:Label name="searchTitle" class="help-title" />
                <ui:ScrollView name="searchList" class="search-list" />
                <ui:Button name="searchClose" class="hud-button help-close" text="Close" />
            </ui:VisualElement>
            <ui:VisualElement name="gamesPanel" class="search-panel hidden">
                <ui:Label name="gamesTitle" class="selection-title" text="Open a game" />
                <ui:ScrollView name="gamesList" class="search-list" />
                <ui:Label name="gamesHint" class="selection-detail" />
                <ui:Button name="gamesClose" class="hud-button" text="Close" />
            </ui:VisualElement>
            <ui:VisualElement name="playersPanel" class="search-panel players-panel hidden">
                <ui:Label class="selection-title" text="Players" />
                <ui:ScrollView name="playersList" class="search-list" />
                <ui:Label name="playersHint" class="selection-detail" />
                <ui:Button name="playersClose" class="hud-button" text="Close" />
            </ui:VisualElement>
            <ui:VisualElement name="helpPanel" class="help-panel hidden">
                <ui:Label name="helpTitle" class="help-title" text="Controls" />
                <ui:ScrollView name="helpList" class="help-list" />
                <ui:Button name="helpClose" class="hud-button help-close" text="Close (F1)" />
            </ui:VisualElement>
            <ui:VisualElement name="escapePanel" class="escape-panel hidden">
                <ui:Label class="help-title escape-title" text="Table World" />
                <ui:Button name="escResume" class="hud-button escape-button" text="Resume" />
                <ui:Button name="escSaves" class="hud-button escape-button" text="Save &amp; load" />
                <ui:Button name="escSettings" class="hud-button escape-button" text="Settings" />
                <ui:Button name="escControls" class="hud-button escape-button" text="Controls" />
                <ui:Button name="escLeave" class="hud-button escape-button" text="Leave session" />
                <ui:Button name="escQuit" class="hud-button escape-button" text="Quit to desktop" />
                <ui:VisualElement name="escQuitConfirm" class="escape-confirm hidden">
                    <ui:Label name="escQuitQuestion" class="selection-detail" text="Quit Table World?" />
                    <ui:VisualElement class="escape-confirm-row">
                        <ui:Button name="escQuitYes" class="hud-button escape-danger" text="Quit" />
                        <ui:Button name="escQuitNo" class="hud-button" text="Cancel" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="savesPanel" class="help-panel settings-panel hidden">
                <ui:Label class="help-title" text="Save &amp; load" />
                <ui:VisualElement class="saves-new">
                    <ui:TextField name="saveName" class="settings-text saves-name-field" />
                    <ui:Button name="saveNamed" class="hud-button" text="Save" />
                </ui:VisualElement>
                <ui:ScrollView name="savesList" class="help-list" />
                <ui:Label name="savesHint" class="settings-note" />
                <ui:VisualElement class="settings-buttons">
                    <ui:Button name="savesBack" class="hud-button" text="Back (Esc)" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="settingsPanel" class="help-panel settings-panel hidden">
                <ui:Label class="help-title" text="Settings" />
                <ui:ScrollView name="settingsList" class="help-list" />
                <ui:VisualElement class="settings-buttons">
                    <ui:Button name="settingsReset" class="hud-button" text="Reset to defaults" />
                    <ui:Button name="settingsBack" class="hud-button" text="Back (Esc)" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="gizmoPanel" class="gizmo-panel hidden">
                <ui:Label name="gizmoTitle" class="selection-title" />
                <ui:VisualElement name="gizmoFields" />
                <ui:VisualElement class="settings-buttons">
                    <ui:Button name="gizmoApply" class="hud-button" text="Apply (Enter)" />
                    <ui:Button name="gizmoClose" class="hud-button" text="Close" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="contextMenu" class="context-menu hidden" />
        </ui:VisualElement>
        <ui:VisualElement name="topBar" class="top-bar">
            <ui:Label name="turnLabel" class="turn-label" text="Free play" />
            <ui:VisualElement name="seatList" class="seat-list" picking-mode="Ignore" />
            <ui:Button name="gamesButton" class="hud-button" text="Games" />
            <ui:Button name="playersButton" class="hud-button hidden" text="Players" />
            <ui:Button name="helpButton" class="hud-button" text="Controls" />
            <ui:Label name="netStatus" class="seat-name net-status" />
            <ui:TextField name="netAddress" class="net-address" value="127.0.0.1:7777" />
            <ui:Button name="hostButton" class="hud-button" text="Host LAN" />
            <ui:Button name="hostOnlineButton" class="hud-button" text="Host online" />
            <ui:Button name="joinButton" class="hud-button" text="Join" />
            <ui:Button name="saveButton" class="hud-button" text="Save (F5)" />
            <ui:Button name="loadButton" class="hud-button" text="Load (F9)" />
        </ui:VisualElement>
        <ui:VisualElement name="toolBar" class="tool-bar">
            <ui:Button name="toolGrab" class="tool-button tool-button--active" text="Grab" tooltip="Pick up and move (Esc)" />
            <ui:Button name="toolDraw" class="tool-button" text="Draw" tooltip="Draw on the table in your colour" />
            <ui:Button name="toolArrow" class="tool-button" text="Arrow" tooltip="Drag to draw an arrow" />
            <ui:Button name="toolErase" class="tool-button" text="Erase" tooltip="Drag over drawings to erase them" />
            <ui:Button name="toolGizmo" class="tool-button" text="Gizmo" tooltip="Click an object to place it exactly" />
        </ui:VisualElement>
        <ui:VisualElement name="gamePanel" class="game-panel hidden">
            <ui:Label name="gameLog" class="game-log" />
            <ui:VisualElement name="gameActions" class="actions" />
        </ui:VisualElement>
        <ui:VisualElement name="handBar" class="hand-bar hidden" picking-mode="Ignore" />
        <ui:Button name="handToggle" class="hand-toggle hidden" text="Hide hand" />
        <ui:VisualElement name="blindfold" class="blindfold hidden" picking-mode="Ignore">
            <ui:Label class="blindfold-text" text="Blindfolded. Press B to take it off." picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="bottomRow" class="bottom-row" picking-mode="Ignore">
            <ui:VisualElement name="leftColumn" class="left-column" picking-mode="Ignore">
                <ui:VisualElement name="chatPanel" class="chat-panel">
                    <ui:VisualElement name="chatTabs" class="chat-tabs">
                        <ui:Button name="chatTab" class="chat-tab chat-tab--active" text="Chat" />
                        <ui:Button name="logTab" class="chat-tab" text="Log" />
                    </ui:VisualElement>
                    <ui:ScrollView name="chatList" class="chat-list" />
                    <ui:Label name="chatHint" class="chat-hint" text="Enter to chat" />
                    <ui:TextField name="chatInput" class="chat-input" />
                </ui:VisualElement>
                <ui:VisualElement name="selectionPanel" class="selection-panel hidden">
                    <ui:Label name="selectionTitle" class="selection-title" />
                    <ui:Label name="selectionDetail" class="selection-detail" />
                    <ui:VisualElement name="actions" class="actions" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="statusLabel" class="status-label hidden" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
